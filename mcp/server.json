{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.PGHQdev/openscreenshot",
  "title": "OpenScreenShot",
  "description": "Capture website screenshots (viewport or full page) with your installed Chrome. Runs locally.",
  "websiteUrl": "https://openscreenshot.app",
  "repository": {
    "url": "https://github.com/PGHQdev/OpenScreenShot",
    "source": "github",
    "subfolder": "mcp"
  },
  "version": "2.4.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "openscreenshot",
      "version": "2.4.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ],
      "environmentVariables": [
        {
          "name": "CHROME_PATH",
          "description": "Path to a Chrome, Chromium, or Edge executable. Leave unset to auto-detect.",
          "isRequired": false,
          "format": "filepath"
        }
      ]
    }
  ]
}
