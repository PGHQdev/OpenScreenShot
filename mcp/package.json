{
  "name": "openscreenshot",
  "version": "2.3.1",
  "description": "Take website screenshots from the terminal, CI, or an AI agent. Local CLI and MCP server that drives your installed Chrome.",
  "keywords": [
    "screenshot",
    "full-page-screenshot",
    "website-screenshot",
    "cli",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "headless-chrome",
    "puppeteer",
    "png",
    "ci",
    "ai-agent"
  ],
  "homepage": "https://openscreenshot.app",
  "bugs": {
    "url": "https://github.com/PGHQdev/OpenScreenShot/issues"
  },
  "funding": "https://ko-fi.com/pghqdev",
  "license": "MIT",
  "author": "OpenScreenShot @PGHQdev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PGHQdev/OpenScreenShot.git",
    "directory": "mcp"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "openscreenshot": "dist/bin.js",
    "openscreenshot-mcp": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "puppeteer-core": "^25.10.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
