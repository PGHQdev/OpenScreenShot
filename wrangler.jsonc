{
  "name": "openscreenshot",
  "compatibility_date": "2026-07-27",
  "main": "site-worker.js",
  // docs/ is Astro's outDir and is git-ignored, so a bare `wrangler deploy`
  // (what Workers Builds runs) has nothing to upload. Wrangler runs this
  // before deploy and before `wrangler dev`.
  "build": {
    "command": "npm run site:build",
  },
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/kofi-widget.js", "/kofi-cdn/*"],
  },
  // Uninstall feedback, and nothing else. Schema and what it deliberately does
  // not hold: site/migrations/0001_feedback.sql. Apply a migration with
  // `npx wrangler d1 migrations apply openscreenshot-feedback --remote`.
  "d1_databases": [
    {
      "binding": "FEEDBACK_DB",
      "database_name": "openscreenshot-feedback",
      "database_id": "462b6679-10de-4c97-bc31-c8b895df66fe",
      "migrations_dir": "site/migrations",
    },
  ],
}
