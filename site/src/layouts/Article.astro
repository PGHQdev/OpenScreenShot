---
import Base from './Base.astro';
import { ld } from '../lib/json-ld';
import { t, localizePath, LANG_TAGS, type Locale } from '../i18n';
import '../styles/doc.css';

interface Props {
  title: string;
  description: string;
  audience: 'everyday' | 'developers';
  /** Locale-less canonical path: '/blog/redact-screenshot/'. */
  path: string;
  locale: Locale;
  /** Locales that have a translation of this post, for hreflang. */
  availableLocales: readonly Locale[];
}
const { title, description, audience, path, locale, availableLocales } = Astro.props;
const b = t(locale, 'blog');
const c = t(locale, 'common');
const url = new URL(localizePath(locale, path), Astro.site).href;
const blogPath = localizePath(locale, '/blog/');
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: title,
      description,
      inLanguage: LANG_TAGS[locale],
      mainEntityOfPage: url,
      author: { '@type': 'Organization', name: 'OpenScreenShot', url: Astro.site?.href },
      publisher: { '@type': 'Organization', name: 'OpenScreenShot', url: Astro.site?.href },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: c.breadcrumbHome, item: new URL(localizePath(locale, '/'), Astro.site).href },
        { '@type': 'ListItem', position: 2, name: b.label, item: new URL(blogPath, Astro.site).href },
        { '@type': 'ListItem', position: 3, name: title, item: url },
      ],
    },
  ],
};
---

<Base title={`${title} — OpenScreenShot`} description={description} path={path} locale={locale} pageType="article" availableLocales={availableLocales}
  navLinks={[{ href: localizePath(locale, '/docs/'), label: c.nav.docs }, { href: blogPath, label: b.label }, { href: localizePath(locale, '/support/'), label: c.nav.support }]}>
  <script slot="head" type="application/ld+json" set:html={ld(structuredData)} />
  <article class="doc container">
    <header class="doc-head">
      <p class="eyebrow"><a href={blogPath}>{b.label}</a> · {b.audiences[audience]}</p>
      <h1>{title}</h1>
      <p class="doc-lead">{description}</p>
      <p class="doc-fine">{b.byline} <a href="https://github.com/pghqdev/OpenScreenShot">OpenScreenShot</a></p>
    </header>
    <div class="article-body"><slot /></div>
    <aside class="doc-section" aria-label={b.next.heading}>
      <h2>{b.next.heading}</h2>
      <p set:html={b.next.body} />
    </aside>
  </article>
</Base>

<style>
  .article-body { max-width: var(--max-w); }
  .article-body :global(h2) { margin-top: var(--s-7); }
  .article-body :global(h3) { margin-top: var(--s-5); }
</style>
