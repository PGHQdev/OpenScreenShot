---
/**
 * The five sub-pages all wear this shell: Base.astro's head, nav and footer,
 * one cross-page nav, and the eyebrow / heading / lead block at the top. Pages
 * supply their own sections through the default slot and their own structured
 * data through `head`.
 */
import Base from './Base.astro';
import type { NavLink } from './Base.astro';
import '../styles/doc.css';
import { ld } from '../lib/json-ld';

interface Props {
  title: string;
  description: string;
  /** Canonical path, leading and trailing slash included: '/docs/'. */
  path: string;
  /** Monospace eyebrow above the heading. */
  label: string;
  heading: string;
  lead: string;
}

// The full nav, with cross-page links. Only the homepage nav is anchors-only.
const navLinks: NavLink[] = [
  { href: '/docs/', label: 'Docs' },
  { href: '/support/', label: 'Support' },
  { href: '/roadmap/', label: 'Roadmap' },
  { href: '/cool-stuff/', label: 'Cool stuff' },
  { href: 'https://github.com/pghqdev/OpenScreenShot', label: 'GitHub', external: true },
];

const { title, description, path, label, heading, lead } = Astro.props;

// Every sub-page is one level below Home, so the trail is always Home > this
// page. `heading` is each page's own h1 text, which is also the plainest
// name for the crumb.
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: heading, item: new URL(path, Astro.site).href },
  ],
};

---

<Base title={title} description={description} path={path} navLinks={navLinks}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={ld(breadcrumbLd)} />
    <slot name="head" />
  </Fragment>

  <div class="doc container">
    <header class="doc-head">
      <p class="eyebrow">{label}</p>
      <h1>{heading}</h1>
      <p class="doc-lead">{lead}</p>
    </header>
    <slot />
  </div>
</Base>
