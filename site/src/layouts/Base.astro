---
import BrandMark from '../components/BrandMark.astro';
import ChromeIcon from '../components/ChromeIcon.astro';
import ogCard from '../assets/og-card.png';
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';

export type NavLink = {
  href: string;
  label: string;
  /** Adds target="_blank" rel="noopener". Off-site links only. */
  external?: boolean;
};

export interface Props {
  title: string;
  description: string;
  /** Canonical path, leading and trailing slash included: '/', '/docs/'. */
  path: string;
  /** Site-absolute path to the social card. Pairs with ogImageAlt. */
  ogImage?: string;
  /** Alt text for ogImage. Required by og:image:alt whenever ogImage is overridden. */
  ogImageAlt?: string;
  pageType?: 'website' | 'article';
  /**
   * Nav entries between the brand and the install CTA. The homepage passes
   * same-page anchors only; sub-pages pass cross-page links.
   */
  navLinks?: NavLink[];
}

const STORE_URL = 'https://chromewebstore.google.com/detail/hdabbojjccojlapnfjpdppcpfcnhgmdp';
const REPO_URL = 'https://github.com/pghqdev/OpenScreenShot';
const OG_DEFAULT = {
  src: ogCard.src,
  width: String(ogCard.width),
  height: String(ogCard.height),
  alt: 'OpenScreenShot: full page screenshot and annotation for Chrome. Free, open source, and 100% local.',
};

const {
  title,
  description,
  path,
  ogImage = OG_DEFAULT.src,
  ogImageAlt = OG_DEFAULT.alt,
  pageType = 'website',
  navLinks = [],
} = Astro.props;

const canonical = new URL(path, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const year = new Date().getFullYear();
const isHome = path === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content="OpenScreenShot" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {
      ogImage === OG_DEFAULT.src && (
        <>
          <meta property="og:image:width" content={OG_DEFAULT.width} />
          <meta property="og:image:height" content={OG_DEFAULT.height} />
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link
      rel="preload"
      href="/fonts/inter-latin-800-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-head">
      <nav class="container-wide nav" aria-label="Primary">
        <a class="nav-brand" href={isHome ? '#top' : '/'}>
          <BrandMark size={24} />
          OpenScreenShot
        </a>
        <ul class="nav-links">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a class="btn nav-cta" href={STORE_URL} target="_blank" rel="noopener">
              <ChromeIcon size={18} />
              Add to Chrome
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="container-wide foot-grid">
        <div class="foot-brand-block">
          <p class="foot-brand">
            <BrandMark size={22} />
            OpenScreenShot
          </p>
          <p class="foot-tag">Screenshots that never leave your machine.</p>
          <p class="foot-bottom">
            © {year} OpenScreenShot
            <a href="https://x.com/PGHQdev" target="_blank" rel="noopener">@PGHQdev</a>
          </p>
        </div>
        <nav class="foot-col" aria-label="Product">
          <p class="foot-head">Product</p>
          <a href="/docs/">Docs</a>
          <a href="/roadmap/">Roadmap</a>
          <a href="/support/">Support & FAQ</a>
        </nav>
        <nav class="foot-col" aria-label="Project">
          <p class="foot-head">Project</p>
          <a href={REPO_URL} target="_blank" rel="noopener">GitHub</a>
          <a href={`${REPO_URL}/blob/main/LICENSE`} target="_blank" rel="noopener">MIT License</a>
          <a href="/privacy/">Privacy</a>
        </nav>
        <nav class="foot-col" aria-label="More by PGHQdev">
          <p class="foot-head">More by @PGHQdev</p>
          {
            [
              { href: 'https://opentechcheck.com', icon: 'opentechcheck', label: 'OpenTechCheck' },
              { href: 'https://hnterminal.com', icon: 'hnterminal', label: 'HN Terminal' },
              {
                href: 'https://minimalistnotes.com',
                icon: 'minimalistnotes',
                label: 'Minimalist Notes',
              },
              { href: 'https://musing.wiki', icon: 'musing', label: 'Musing' },
              {
                href: 'https://ko-fi.com/T7A624DAY7',
                icon: 'ko-fi',
                label: 'Support Open-Source',
              },
            ].map((link) => (
              <a class="foot-site" href={link.href} target="_blank" rel="noopener">
                <img
                  src={`/assets/favicons/${link.icon}.png`}
                  alt=""
                  width="16"
                  height="16"
                  loading="lazy"
                />
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>
    </footer>

    <slot name="body-end" />

    <script>
      // The sticky nav's scrolled state: past 24px the bar frosts and the
      // brand and CTA glide from the container edge to the viewport edge
      // (the .nav padding transition below).
      const head = document.querySelector('.site-head');
      if (head) {
        const onScroll = () => head.toggleAttribute('data-scrolled', window.scrollY > 24);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
  </body>
</html>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--paper);
    box-shadow: inset 0 -1px 0 transparent;
    backdrop-filter: blur(14px) saturate(1.5);
    -webkit-backdrop-filter: blur(14px) saturate(1.5);
    transition:
      background-color var(--dur-slow) var(--ease),
      box-shadow var(--dur-slow) var(--ease);
  }

  .site-head[data-scrolled] {
    background: rgba(255, 255, 255, 0.82);
    box-shadow: inset 0 -1px 0 var(--rule);
  }

  /* At rest the row hugs the content column; scrolled, its inline padding
   * eases down to the page gutter, so the brand and the CTA glide out to
   * the viewport edges. Overrides .container-wide's max-width for that.
   * The at-rest gutter is a plain calc(), not max(): a max() expression
   * does not interpolate against a plain length, so the transition would
   * snap. Below 1089px the two gutters are equal and nothing moves. */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    flex-wrap: wrap;
    max-width: none;
    padding-block: var(--s-4);
    padding-inline: var(--s-5);
    transition: padding var(--dur-slow) var(--ease);
  }

  @media (min-width: 1089px) {
    .site-head:not([data-scrolled]) .nav {
      padding-inline: calc((100% - var(--max-w-wide)) / 2 + var(--s-5));
    }
  }

  .site-head[data-scrolled] .nav {
    padding-block: var(--s-3);
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--ink);
    font-size: var(--fs-base);
    font-weight: 800;
    letter-spacing: var(--tr-tight);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-sm);
  }

  .nav-links a {
    color: var(--ink-2);
    font-weight: 500;
    text-decoration: none;
  }

  .nav-links a:hover {
    color: var(--ink);
  }

  .nav-links .nav-cta {
    min-height: 40px;
    padding: 0 var(--s-4) 0 var(--s-3);
    background: var(--ink);
    color: #fff;
    font-size: var(--fs-sm);
  }

  /* The plain-link hover above would ink the label; the pill stays white. */
  .nav-links .nav-cta:hover {
    background: color-mix(in srgb, var(--ink) 85%, #fff);
    color: #fff;
  }

  .site-foot {
    margin-top: var(--s-6);
    padding-block: var(--s-7) var(--s-7);
    border-top: 1px solid var(--rule);
    background: var(--paper-dim);
    color: var(--ink-3);
    font-size: var(--fs-sm);
  }

  .foot-grid {
    display: grid;
    gap: var(--s-6);
  }

  .foot-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin: 0 0 var(--s-3);
    color: var(--ink);
    font-size: var(--fs-md);
    font-weight: 800;
    letter-spacing: var(--tr-tight);
  }

  .foot-tag {
    max-width: 26ch;
    margin: 0 0 var(--s-4);
    color: var(--ink-3);
  }

  .foot-bottom {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
  }

  .foot-bottom a {
    color: inherit;
    text-decoration: none;
  }

  .foot-bottom a:hover {
    color: var(--ink);
  }

  .foot-site {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }

  .foot-site img {
    border-radius: 4px;
  }

  .foot-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-2);
  }

  .foot-head {
    margin: 0 0 var(--s-1);
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
  }

  .foot-col a {
    color: var(--ink-2);
    font-weight: 500;
    text-decoration: none;
  }

  .foot-col a:hover {
    color: var(--ink);
  }

  @media (min-width: 760px) {
    .foot-grid {
      grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
      gap: var(--s-6) var(--s-7);
    }
  }

  @media (max-width: 620px) {
    .nav-links {
      gap: var(--s-4);
    }
  }
</style>
