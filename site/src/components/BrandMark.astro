---
/**
 * The site's flat viewfinder mark: coral capture brackets around a coral
 * shutter dot, on a transparent ground. A sibling of the extension icon
 * (scripts/generate-icons.mjs), which keeps its paper tile and ink brackets;
 * the favicons come from the tiled variant in that same script.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 26, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 128 128"
  aria-hidden="true"
  focusable="false"
>
  <g stroke="#E8503A" stroke-width="12" stroke-linecap="round" fill="none">
    <path d="M26 44 v-10 a8 8 0 0 1 8 -8 h10"></path>
    <path d="M84 26 h10 a8 8 0 0 1 8 8 v10"></path>
    <path d="M102 84 v10 a8 8 0 0 1 -8 8 h-10"></path>
    <path d="M44 102 h-10 a8 8 0 0 1 -8 -8 v-10"></path>
  </g>
  <circle cx="64" cy="64" r="15" fill="#E8503A"></circle>
</svg>
