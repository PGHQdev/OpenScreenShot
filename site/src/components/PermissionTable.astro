---
/**
 * One permission table. The homepage privacy section and the Privacy Policy
 * page both render it, from the same list in ../data/permissions.
 *
 * The "When it is requested" column appears only for the optional permissions,
 * which are the rows that carry a `when`.
 */
import type { Permission } from '../data/permissions';
import { t, DEFAULT_LOCALE, type Locale } from '../i18n';

interface Props {
  rows: Permission[];
  /** URL locale of this render. Defaults to en for pages not yet localized. */
  locale?: Locale;
}

const { rows, locale = DEFAULT_LOCALE } = Astro.props;
const c = t(locale, 'common').permissionTable;
const hasWhen = rows.some((row) => row.when);
---

<table class="perms">
  <thead>
    <tr>
      <th scope="col">{c.permission}</th>
      <th scope="col">{c.why}</th>
      {hasWhen && <th scope="col">{c.when}</th>}
    </tr>
  </thead>
  <tbody>
    {
      rows.map((row) => (
        <tr>
          <th scope="row">
            <code>{row.name}</code>
          </th>
          <td>{row.why}</td>
          {hasWhen && <td>{row.when}</td>}
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .perms {
    width: 100%;
    margin-bottom: var(--s-5);
    border-collapse: collapse;
    font-size: var(--fs-md);
    text-align: left;
  }

  .perms th,
  .perms td {
    padding: var(--s-3) var(--s-4) var(--s-3) 0;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  .perms thead th {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--fs-xs);
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
  }

  .perms tbody th {
    width: 13rem;
    color: var(--ink);
    font-weight: 400;
  }

  .perms td {
    color: var(--ink-2);
  }

  /* Narrow screens: one stacked block per permission, the column headers
   * kept for assistive tech only. */
  @media (max-width: 620px) {
    .perms,
    .perms tbody,
    .perms tr,
    .perms th,
    .perms td {
      display: block;
    }

    .perms thead {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .perms tr {
      padding-block: var(--s-3);
      border-bottom: 1px solid var(--border);
    }

    .perms th,
    .perms td {
      width: auto;
      padding: 0 0 var(--s-2);
      border: 0;
    }

    .perms td:last-child {
      padding-bottom: 0;
    }
  }
</style>
