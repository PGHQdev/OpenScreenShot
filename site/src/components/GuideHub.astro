---
import Base from '../layouts/Base.astro';
import { ld } from '../lib/json-ld';
import { t, localizePath, LOCALES, LANG_TAGS, type Locale } from '../i18n';
import { guideParts, sectionGuides, type GuideSection } from '../lib/guides';
import '../styles/doc.css';

interface Props {
  section: GuideSection;
  locale: Locale;
}
const { section, locale } = Astro.props;
const all = await sectionGuides(section);
const availableLocales = LOCALES.filter((l) => all.some((g) => guideParts(g).locale === l));
const s = t(locale, 'guides').sections[section];
const c = t(locale, 'common');
const b = t(locale, 'blog');
const path = `/${section}/`;
const pageUrl = new URL(localizePath(locale, path), Astro.site).href;
const pages = all
  .filter((g) => guideParts(g).locale === locale)
  .map((g) => ({ ...g.data, href: localizePath(locale, `${path}${guideParts(g).slug}/`) }))
  .sort((a, z) => a.order - z.order);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: s.heading,
      description: s.description,
      url: pageUrl,
      inLanguage: LANG_TAGS[locale],
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: pages.map((p, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: p.title,
          url: new URL(p.href, Astro.site).href,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: c.breadcrumbHome, item: new URL(localizePath(locale, '/'), Astro.site).href },
        { '@type': 'ListItem', position: 2, name: s.label, item: pageUrl },
      ],
    },
  ],
};
---

<Base title={s.title} description={s.description} path={path} locale={locale} availableLocales={availableLocales}
  navLinks={[{ href: localizePath(locale, '/docs/'), label: c.nav.docs }, { href: localizePath(locale, '/blog/'), label: b.label }, { href: localizePath(locale, '/support/'), label: c.nav.support }]}>
  <script slot="head" type="application/ld+json" set:html={ld(structuredData)} />
  <div class="doc container">
    <header class="doc-head">
      <p class="eyebrow">{s.label}</p>
      <h1>{s.heading}</h1>
      <p class="doc-lead">{s.lead}</p>
    </header>
    <section class="doc-section">
      <ul>
        {pages.map((p) => (
          <li>
            <h2><a href={p.href}>{p.title}</a></h2>
            <p>{p.description}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
