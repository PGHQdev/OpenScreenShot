---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ChromeIcon from '../../components/ChromeIcon.astro';
import FaqList from '../../components/FaqList.astro';
import PermissionTable from '../../components/PermissionTable.astro';
import { getHomeFaq } from '../../data/faq';
import { getInstallPermissions, getRecordingPermissions } from '../../data/permissions';
import { ld } from '../../lib/json-ld';
import { t, localePaths, localeFromParams, localizePath, LANG_TAGS } from '../../i18n';
import hero from '../../assets/hero.webp';
import shotEditor from '../../assets/shot-3.webp';
import shotExport from '../../assets/shot-4.webp';
import shotRecorder from '../../assets/shot-5.webp';

export const getStaticPaths = localePaths;

const locale = localeFromParams(Astro.params.lang);
const d = t(locale, 'home');
const c = t(locale, 'common');
const homeFaq = getHomeFaq(locale);

const STORE_URL = 'https://chromewebstore.google.com/detail/hdabbojjccojlapnfjpdppcpfcnhgmdp';
const REPO_URL = 'https://github.com/pghqdev/OpenScreenShot';

// The homepage nav is the reference's minimal pair: brand left, install pill
// right, nothing between. Cross-page links live in the footer, which also
// keeps the page's One Page Love eligibility. Section ids stay for deep links.

// The in-house line icon set: one 24px grid, one stroke, coral only.
const icons = {
  capture:
    'M8 4H6a2 2 0 0 0-2 2v2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2M14.4 12a2.4 2.4 0 1 1-4.8 0 2.4 2.4 0 0 1 4.8 0Z',
  pen: 'm4 20 1.2-4.2L16.7 4.3a2.05 2.05 0 0 1 2.9 2.9L8.2 18.8 4 20ZM13.5 6.5l3 3',
  export: 'M12 4v11M7 10.5l5 5 5-5M4.5 19.5h15',
  record: 'M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
  lock: 'M7 11V8a5 5 0 0 1 10 0v3M6.5 11h11a1.5 1.5 0 0 1 1.5 1.5v6A1.5 1.5 0 0 1 17.5 20h-11A1.5 1.5 0 0 1 5 18.5v-6A1.5 1.5 0 0 1 6.5 11Z',
  terminal: 'm5 7 5 5-5 5M12.5 17H19',
};

// The hero's tabbed showcase: one framed stage, four screens and a terminal.
// The CLI tab has no image; the panel renders the terminal markup below.
// Labels and alt text come from the dictionary; ids, icons and images stay here.
const heroTabs = [
  { id: 'capture', icon: icons.capture, image: hero, ...d.tabs.capture },
  { id: 'annotate', icon: icons.pen, image: shotEditor, ...d.tabs.annotate },
  { id: 'export', icon: icons.export, image: shotExport, ...d.tabs.export },
  { id: 'record', icon: icons.record, image: shotRecorder, ...d.tabs.record },
  { id: 'cli', icon: icons.terminal, image: null, alt: '', ...d.tabs.cli },
];

// The quartet under the hero: the reasons to install, benefit first. The hero
// tabs above already show each screen, so these carry no screenshots. Each
// card wears one Chrome brand color, zipped by index with the dictionary text.
const quartetMeta = [
  { icon: icons.capture, tone: 'tone-blue' },
  { icon: icons.pen, tone: 'tone-green' },
  { icon: icons.record, tone: 'tone-red' },
  { icon: icons.lock, tone: 'tone-yellow' },
];
const quartet = quartetMeta.map((meta, i) => ({ ...meta, ...d.quartet[i] }));

// The proof strip's live numbers sit inside translated sentences; each
// sentence carries an {n} placeholder the <b data-stat> markup replaces.
const [usersPre, usersPost] = d.proof.users.split('{n}');
const [starsPre, starsPost] = d.proof.stars.split('{n}');

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'OpenScreenShot',
  applicationCategory: 'BrowserApplication',
  operatingSystem: 'Chrome',
  description: d.meta.description,
  url: new URL(localizePath(locale, '/'), Astro.site).href,
  downloadUrl: STORE_URL,
  softwareVersion: '1.5.0',
  license: `${REPO_URL}/blob/main/LICENSE`,
  isAccessibleForFree: true,
  inLanguage: LANG_TAGS[locale],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: 'PGHQ.dev', url: 'https://github.com/pghqdev' },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

// The <details> below and mainEntity above both read homeFaq, so they cannot
// drift. This guard fails the build if a later edit gives either its own source.
if (faqLd.mainEntity.length !== homeFaq.length) {
  throw new Error(
    `FAQ drift: ${faqLd.mainEntity.length} structured answers for ${homeFaq.length} rendered questions.`,
  );
}
---

<Base title={d.meta.title} description={d.meta.description} path="/" locale={locale}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={ld(softwareLd)} />
    <script type="application/ld+json" set:html={ld(faqLd)} />
  </Fragment>

  <!-- Hero -->
  <section id="top" class="hero">
    <div class="container-wide hero-copy">
      <p class="hero-note">{d.hero.note}</p>
      <h1>{d.hero.title1}<br />{d.hero.title2}</h1>
      <p class="sub">{d.hero.sub}</p>
      <p class="cta-row">
        <a class="btn btn-ink" href={STORE_URL} target="_blank" rel="noopener">
          <ChromeIcon size={18} />
          {c.nav.addToChrome}
        </a>
        <a class="btn btn-quiet" href={REPO_URL} target="_blank" rel="noopener">
          <svg class="gh-mark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path>
          </svg>
          {d.hero.viewOnGithub}
        </a>
      </p>
    </div>
    <div class="container-hero">
      <div class="hero-frame">
        <div class="hero-tabs" role="tablist" aria-label={d.hero.tablistLabel}>
          <span class="hero-tabs-thumb" aria-hidden="true"></span>
          {
            heroTabs.map((tab, i) => (
              <button
                id={`hero-tab-${tab.id}`}
                class="hero-tab"
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`hero-panel-${tab.id}`}
                aria-label={'short' in tab ? tab.label : undefined}
                tabindex={i === 0 ? undefined : -1}
              >
                <svg class="tab-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d={tab.icon} />
                </svg>
                {
                  'short' in tab ? (
                    <>
                      <span class="tab-long">{tab.label}</span>
                      <span class="tab-short" aria-hidden="true">
                        {tab.short}
                      </span>
                    </>
                  ) : (
                    tab.label
                  )
                }
              </button>
            ))
          }
        </div>
        {
          heroTabs.map((tab, i) => (
            <div
              id={`hero-panel-${tab.id}`}
              class="hero-panel"
              role="tabpanel"
              aria-labelledby={`hero-tab-${tab.id}`}
              hidden={i !== 0}
            >
              {
                tab.image ? (
                  <Picture
                    src={tab.image}
                    alt={tab.alt}
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    widths={[640, 960, 1280, 1800, 2400]}
                    sizes="(min-width: 1248px) 1200px, calc(100vw - 88px)"
                    fetchpriority={i === 0 ? 'high' : undefined}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                ) : (
                  <div class="term">
                    <div class="term-bar">
                      <span class="term-dot" />
                      <span class="term-dot" />
                      <span class="term-dot" />
                      <p class="term-title">openscreenshot — zsh</p>
                    </div>
                    <div class="term-body">
                      <p class="term-comment">{d.term.commentShot}</p>
                      <p class="term-cmd">
                        <span class="term-prompt">$</span> npx openscreenshot shot
                        https://example.com --out shot.png --full
                      </p>
                      <p class="term-out">Saved shot.png · full page · 1440×3120</p>
                      <p class="term-comment">{d.term.commentServe}</p>
                      <p class="term-cmd">
                        <span class="term-prompt">$</span> npx openscreenshot serve
                      </p>
                      <p class="term-out">MCP server ready · tool: capture_screenshot</p>
                      <p class="term-comment">{d.term.commentConfig}</p>
                      <p class="term-cmd">
                        {'{ "command": "npx", "args": ["openscreenshot", "serve"] }'}
                      </p>
                    </div>
                  </div>
                )
              }
            </div>
          ))
        }
      </div>
      <p class="hero-credit">
        {d.hero.credit}
        <a href="https://opentechcheck.com" target="_blank" rel="noopener">{d.hero.creditCta}</a>
      </p>
    </div>
  </section>

  <!-- Proof. site-worker.js rewrites the two data-stat elements at the edge,
       and the script below refreshes them from /api/stats.json in the
       browser; the numbers in the markup are the fallback when both miss. -->
  <section class="proof-strip" aria-label={d.proof.ariaLabel}>
    <ul class="container-wide proof">
      <li>{usersPre}<b data-stat="users">1k</b>{usersPost}</li>
      <li>{starsPre}<b data-stat="stars">66</b>{starsPost}</li>
      <li>{d.proof.mit}</li>
      <li>{d.proof.offline}</li>
    </ul>
  </section>

  <!-- Quartet -->
  <section id="features" class="section trio-section">
    <div class="container-wide">
      <ul class="trio">
        {
          quartet.map((t) => (
            <li>
              <svg
                class:list={['icon', t.tone]}
                viewBox="0 0 24 24"
                aria-hidden="true"
                focusable="false"
              >
                <path d={t.icon} />
              </svg>
              <h2>{t.title}</h2>
              <p class="trio-body">{t.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Privacy -->
  <section id="privacy" class="section slab">
    <div class="container-wide split">
      <div>
        <p class="eyebrow">{d.privacy.eyebrow}</p>
        <h2>{d.privacy.heading}</h2>
        <p class="lede">{d.privacy.lede}</p>
      </div>
      <dl class="card receipt">
        {
          d.privacy.receipt.map((row: { k: string; v: string }) => (
            <div>
              <dt>{row.k}</dt>
              <dd>{row.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="container-wide">
      <details class="card perm-fold">
        <summary>
          {d.privacy.installFold}
          <span class="fold-mark" aria-hidden="true"></span>
        </summary>
        <div class="fold-body">
          <PermissionTable rows={getInstallPermissions(locale)} locale={locale} />
        </div>
      </details>
      <details class="card perm-fold">
        <summary>
          {d.privacy.recordFold}
          <span class="fold-mark" aria-hidden="true"></span>
        </summary>
        <div class="fold-body">
          <PermissionTable rows={getRecordingPermissions(locale)} locale={locale} />
          <p class="fine">{d.privacy.micFine}</p>
        </div>
      </details>
      <p class="fine" set:html={d.privacy.moreFine} />
      <p class="fine">
        <a href={localizePath(locale, '/compare/')}>{d.privacy.compareLine}</a>
      </p>
    </div>
  </section>

  <!-- Agents & CLI -->
  <section id="cli" class="section">
    <div class="container-wide">
      <p class="eyebrow">
        <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d={icons.terminal} />
        </svg>
        {d.cli.eyebrow}
      </p>
      <h2>{d.cli.heading} <span class="muted">{d.cli.headingMuted}</span></h2>
      <div class="card cli">
        <div class="cli-about">
          <p class="cli-name" set:html={d.cli.name} />
          <ul>
            {d.cli.bullets.map((bullet: string) => <li set:html={bullet} />)}
          </ul>
        </div>
        <div class="cli-code">
          <p class="cli-label">{d.cli.labelShot}</p>
          <pre class="code"><code>npx openscreenshot shot https://example.com --out shot.png --full</code></pre>
          <p class="cli-label">{d.cli.labelConfig}</p>
          <pre class="code"><code>{'{ "command": "npx", "args": ["openscreenshot", "serve"] }'}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section">
    <div class="container-wide">
      <p class="eyebrow">{d.faq.eyebrow}</p>
      <h2>{d.faq.heading}</h2>
      <FaqList items={homeFaq} />
      <p class="fine" set:html={d.faq.moreFine} />
    </div>
  </section>

  <!-- Final CTA -->
  <section id="download" class="section cta-final">
    <div class="container-wide">
      <h2>{d.cta.heading}</h2>
      <ol class="steps">
        {
          d.cta.steps.map((step: { title: string; body: string }, i: number) => (
            <li class="card step">
              <p class="step-n" aria-hidden="true">
                {i + 1}
              </p>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="cta-row">
        <a class="btn btn-ink btn-install" href={STORE_URL} target="_blank" rel="noopener">
          <ChromeIcon size={22} />
          {c.nav.addToChrome}
        </a>
      </p>
      <p class="fine">{d.cta.browsersFine}</p>
    </div>
  </section>

  <Fragment slot="body-end">
    <script is:inline src="/assets/webmcp.js" defer></script>
  </Fragment>
</Base>

<script>
  // The hero showcase: a sliding white thumb under the active tab, panels
  // toggled through [hidden]. Arrow keys move between tabs per the ARIA
  // tabs pattern.
  const tablist = document.querySelector<HTMLElement>('.hero-tabs');
  const thumb = tablist?.querySelector<HTMLElement>('.hero-tabs-thumb');
  const tabs = [...(tablist?.querySelectorAll<HTMLButtonElement>('.hero-tab') ?? [])];

  function placeThumb(tab: HTMLElement) {
    if (!thumb) return;
    thumb.style.width = `${tab.offsetWidth}px`;
    thumb.style.transform = `translateX(${tab.offsetLeft}px)`;
  }

  function select(tab: HTMLButtonElement, focus = false) {
    for (const t of tabs) {
      const active = t === tab;
      t.setAttribute('aria-selected', String(active));
      if (active) t.removeAttribute('tabindex');
      else t.setAttribute('tabindex', '-1');
      const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !active;
    }
    placeThumb(tab);
    if (focus) tab.focus();
  }

  if (tablist && thumb && tabs.length) {
    tablist.dataset.ready = 'false';
    placeThumb(tabs[0]);
    // Two frames so the initial placement lands before transitions turn on.
    requestAnimationFrame(() => requestAnimationFrame(() => (tablist.dataset.ready = 'true')));

    for (const tab of tabs) {
      tab.addEventListener('click', () => select(tab));
    }
    tablist.addEventListener('keydown', (e) => {
      const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!dir) return;
      e.preventDefault();
      const current = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
      select(tabs[(current + dir + tabs.length) % tabs.length], true);
    });
    window.addEventListener('resize', () => {
      const current = tabs.find((t) => t.getAttribute('aria-selected') === 'true');
      if (current) placeThumb(current);
    });
  }

  // Live counts for the proof strip. The edge already injects them
  // server-side; this refresh covers cached HTML and keeps the numbers
  // current. A miss (offline, localhost) leaves the fallback markup alone.
  fetch('/api/stats.json')
    .then((r) => (r.ok ? r.json() : null))
    .then((stats: Record<string, string | null> | null) => {
      if (!stats) return;
      for (const el of document.querySelectorAll<HTMLElement>('[data-stat]')) {
        const value = stats[el.dataset.stat ?? ''];
        if (value) el.textContent = value;
      }
    })
    .catch(() => {});
</script>

<style>
  /* ---- Rhythm ---- */

  .section {
    padding-block: clamp(56px, 8vw, 112px);
  }

  .section h2 {
    max-width: 26ch;
    margin-bottom: var(--s-6);
    font-size: var(--fs-title);
  }

  .fine {
    max-width: var(--max-w);
    color: var(--ink-3);
    font-size: var(--fs-sm);
  }

  .container-hero {
    max-width: var(--max-w-hero);
    margin-inline: auto;
    padding-inline: var(--s-5);
  }

  .icon {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon-sm {
    width: 16px;
    height: 16px;
  }

  /* One Chrome brand color per quartet card. */
  .tone-blue {
    stroke: var(--chrome-blue);
  }

  .tone-red {
    stroke: var(--chrome-red);
  }

  .tone-yellow {
    stroke: var(--chrome-yellow);
  }

  .tone-green {
    stroke: var(--chrome-green);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--s-3);
    margin: 0;
  }

  .gh-mark {
    width: 18px;
    height: 18px;
  }

  /* ---- Hero ---- */

  .hero {
    padding-top: clamp(48px, 8vw, 104px);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: clamp(40px, 6vw, 64px);
    text-align: center;
  }

  .hero-note {
    margin-bottom: var(--s-5);
    color: var(--ink-3);
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .hero h1 {
    margin-bottom: var(--s-5);
    font-size: var(--fs-hero);
  }

  .sub {
    max-width: 52ch;
    margin: 0 0 var(--s-6);
    color: var(--ink-2);
    font-size: var(--fs-lg);
  }

  /* The stage: panels inset on a Chrome-colored aurora wallpaper, the way the
   * reference floats its window on the Big Sur gradient. The color fallback
   * sits under the image for the moment before it loads. */
  .hero-frame {
    padding: 16px 20px 20px;
    border-radius: 32px;
    background: #4285f4 url('/assets/wallpaper.svg') center / cover no-repeat;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.25),
      0 2px 4px rgba(23, 23, 26, 0.06),
      0 32px 64px -32px rgba(20, 45, 110, 0.45);
  }

  /* The frosted dock the tabs sit in, per the reference: translucent white
   * over the wallpaper, blurred, a hairline light edge. */
  .hero-tabs {
    position: relative;
    display: flex;
    margin: 0 0 14px;
    padding: 6px;
    border-radius: var(--r-full);
    background: rgba(255, 255, 255, 0.18);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
  }

  .hero-tab {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    flex: 1;
    min-width: 0;
    padding: 11px 12px;
    border: 0;
    border-radius: var(--r-full);
    background: none;
    color: rgba(255, 255, 255, 0.88);
    font: inherit;
    font-size: var(--fs-md);
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease);
  }

  .tab-icon {
    width: 15px;
    height: 15px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.9;
  }

  .hero-tab:hover,
  .hero-tab[aria-selected='true'] {
    color: #fff;
  }

  .hero-tab[aria-selected='true'] {
    color: var(--ink);
  }

  .hero-tabs-thumb {
    position: absolute;
    inset-block: 6px;
    left: 0;
    width: 0;
    border-radius: var(--r-full);
    background: #fff;
    box-shadow:
      0 1px 2px rgba(15, 10, 20, 0.1),
      0 6px 16px -8px rgba(15, 10, 20, 0.28);
    transition:
      transform var(--dur-mid) var(--ease),
      width var(--dur-mid) var(--ease);
  }

  /* Until the script measures the tabs (or without JS at all), the thumb
   * spans the first fifth, which is the first of the five equal tabs.
   * The 6px shift and the 2.4px trim mirror the dock's inner padding. */
  .hero-tabs:not([data-ready='true']) .hero-tabs-thumb {
    width: calc(20% - 2.4px);
    transform: translateX(6px);
    transition: none;
  }

  .hero-panel {
    border-radius: 18px;
    overflow: hidden;
    background: var(--paper);
    box-shadow: 0 12px 40px -18px rgba(60, 10, 8, 0.5);
  }

  .hero-panel img {
    width: 100%;
  }

  /* The CLI & MCP panel: a terminal window on the same 5:3 stage as the
   * screenshots, so the frame does not jump between tabs. Content may
   * stretch it taller on narrow screens. */
  .term {
    display: flex;
    flex-direction: column;
    aspect-ratio: 5 / 3;
    background: var(--slab);
    color: var(--slab-ink);
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
    padding: 14px 18px;
    background: rgba(255, 255, 255, 0.06);
