---
import Base from '../../../layouts/Base.astro';
import LocaleRedirect from '../../../components/LocaleRedirect.astro';
import { t, localePaths, localeFromParams, DEFAULT_LOCALE } from '../../../i18n';

export const getStaticPaths = localePaths;
const locale = localeFromParams(Astro.params.lang);
const d = t(locale, 'uninstall');
const REVIEWS_URL = 'https://chromewebstore.google.com/detail/hdabbojjccojlapnfjpdppcpfcnhgmdp/reviews';
const SUPPORT_EMAIL = 'support@minimalistprojects.com';
---

<Base title={d.meta.title} description={d.meta.description} path="/uninstall/" locale={locale} minimal>
  <Fragment slot="head">
    <meta name="robots" content="noindex, follow" />
    {locale === DEFAULT_LOCALE && <LocaleRedirect path="/uninstall/" />}
  </Fragment>

  <div class="goodbye">
    <header class="goodbye-heading">
      <h1>{d.heading}</h1>
      <p class="intro">{d.lead}</p>
      <a class="btn btn-ink rate-link" href={REVIEWS_URL} target="_blank" rel="noopener">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
          <path d="m12 3 2.8 5.7 6.3.9-4.5 4.4 1.1 6.2-5.7-3-5.7 3 1.1-6.2L3.2 9.6l6-.9Z" />
        </svg>
        {d.happy.cta}
      </a>
      <a class="support-link" href="https://ko-fi.com/T7A624DAY7" target="_blank" rel="noopener">{d.support.cta}</a>
      <div class="project-support">
        <h2>{d.support.heading}</h2>
        <p>{d.support.body}</p>
      </div>
    </header>

    <section class="feedback" aria-labelledby="feedback-heading">
      <h2 id="feedback-heading">{d.broken.heading}</h2>
      <p class="feedback-note" id="feedback-note">{d.broken.body}</p>
      <form id="feedback-form" data-locale={locale}>
        <textarea id="feedback-text" rows="4" required maxlength="4000"
          placeholder={d.broken.placeholder} aria-labelledby="feedback-heading" aria-describedby="feedback-note"></textarea>
        <details class="reply-field">
          <summary>{d.broken.replyToggle}</summary>
          <label for="feedback-contact">{d.broken.contactLabel}</label>
          <input id="feedback-contact" type="email" maxlength="200" autocomplete="email" />
        </details>
        <button class="btn btn-quiet" type="submit">{d.broken.cta}</button>
        <p id="feedback-error" class="feedback-error" role="alert" hidden>
          {d.broken.failed} <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>
        </p>
      </form>
      <p id="feedback-thanks" class="feedback-thanks" role="status" tabindex="-1" hidden>{d.broken.thanks}</p>
    </section>
  </div>
</Base>

<style>
  .support-link { display: inline-block; margin: var(--s-3) 0 0 var(--s-4); }
  .project-support { margin-top: var(--s-5); }
  .project-support h2 { font-size: var(--fs-base); margin: 0 0 var(--s-2); }
  .project-support p { margin: 0; color: var(--ink-2); line-height: 1.6; }

  .goodbye {
    width: min(100% - 48px, 560px);
    margin: clamp(40px, 8vh, 80px) auto clamp(48px, 9vh, 96px);
  }
  .goodbye-heading h1 {
    max-width: 18ch;
    margin: 0 0 var(--s-4);
    font-size: clamp(32px, 4.4vw, 48px);
    line-height: 1.12;
    letter-spacing: var(--tr-tight);
    overflow-wrap: anywhere;
  }
  .intro {
    margin: 0 0 var(--s-5);
    color: var(--ink-2);
    font-size: var(--fs-lg);
    line-height: 1.6;
  }
  .rate-link { gap: var(--s-2); }
  .rate-link svg { flex-shrink: 0; }
  .feedback {
    margin-top: var(--s-7);
    padding-top: var(--s-6);
    border-top: 1px solid var(--rule);
  }
  .feedback h2 {
    margin: 0 0 var(--s-2);
    font-size: var(--fs-lg);
    letter-spacing: var(--tr-tight);
  }
  .feedback-note {
    color: var(--ink-2);
    margin: 0 0 var(--s-4);
    font-size: var(--fs-sm);
  }
  textarea, input {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: var(--fs-base);
  }
  textarea { display: block; resize: vertical; min-height: 120px; }
  textarea::placeholder { color: var(--ink-3); }
  textarea:focus-visible, input:focus-visible, summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .reply-field { margin: var(--s-3) 0 var(--s-5); }
  summary { width: fit-content; cursor: pointer; color: var(--ink-2); font-size: var(--fs-sm); }
  summary:hover { color: var(--ink); }
  .reply-field label {
    display: block;
    margin: var(--s-3) 0 var(--s-2);
    color: var(--ink-2);
    font-size: var(--fs-sm);
  }
  .feedback-error, .feedback-thanks { font-size: var(--fs-sm); margin-top: var(--s-4); }
  .feedback-error a { overflow-wrap: anywhere; }
  .feedback-thanks { color: var(--ink-2); }
  button:disabled { opacity: .6; cursor: wait; }
</style>

<script>
  // One POST to /api/feedback: the text, the version from ?v, this page's
  // locale, and an optional reply address. Nothing else about the visitor
  // exists on this page to send. A failure re-shows the form and points at the
  // mail address rather than swallowing what they wrote — the textarea keeps
  // its contents throughout, so a retry costs nothing.
  const form = document.getElementById('feedback-form') as HTMLFormElement;
  const text = document.getElementById('feedback-text') as HTMLTextAreaElement;
  const contact = document.getElementById('feedback-contact') as HTMLInputElement;
  const thanks = document.getElementById('feedback-thanks') as HTMLElement;
  const failed = document.getElementById('feedback-error') as HTMLElement;
  const button = form?.querySelector('button[type="submit"]') as HTMLButtonElement;
  const sending = button?.textContent ?? '';

  // A collapsed optional field must still be reachable if validation fails.
  contact?.addEventListener('invalid', () => {
    const disclosure = contact.closest('details');
    if (disclosure) disclosure.open = true;
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const message = text?.value.trim() ?? '';
    if (!message) return;
    failed.hidden = true;
    button.disabled = true;

    void fetch('/api/feedback', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        message,
        contact: contact?.value.trim() ?? '',
        version: new URLSearchParams(location.search).get('v') ?? 'unknown',
        locale: form.dataset.locale ?? 'en',
      }),
    })
      .then((res) => {
        if (!res.ok) throw new Error(String(res.status));
        form.hidden = true;
        thanks.hidden = false;
        thanks.focus();
      })
      .catch(() => {
        failed.hidden = false;
        button.disabled = false;
        button.textContent = sending;
      });
  });
</script>
