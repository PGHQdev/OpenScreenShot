---
/**
 * Uninstall landing (rating funnel Surface D). chrome.runtime.setUninstallURL
 * points here with ?v=<version>&hl=<locale> — nothing else.
 *
 * Send posts to /api/feedback, which writes one row to D1: what was typed,
 * the version from ?v, this page's locale, and an optional reply address. No
 * IP, no user agent, no cookie, no analytics. It used to open the visitor's
 * mail client instead, which asked someone mid-uninstall to own a mail app and
 * hand over their address to report a missing footer. The mail link stays
 * under the form for anyone who prefers it, and it is also the way through
 * when the endpoint is down.
 */
import Doc from '../../../layouts/Doc.astro';
import LocaleRedirect from '../../../components/LocaleRedirect.astro';
import { t, localePaths, localeFromParams, DEFAULT_LOCALE } from '../../../i18n';

export const getStaticPaths = localePaths;

const locale = localeFromParams(Astro.params.lang);
const d = t(locale, 'uninstall');

const REVIEWS_URL =
  'https://chromewebstore.google.com/detail/hdabbojjccojlapnfjpdppcpfcnhgmdp/reviews';
const REPO_URL = 'https://github.com/pghqdev/OpenScreenShot';
const SUPPORT_EMAIL = 'support@minimalistprojects.com';
---

<Doc
  title={d.meta.title}
  description={d.meta.description}
  path="/uninstall/"
  locale={locale}
  label={d.label}
  heading={d.heading}
  lead={d.lead}
>
  {
    locale === DEFAULT_LOCALE && (
      <Fragment slot="head">
        <LocaleRedirect path="/uninstall/" />
      </Fragment>
    )
  }

  <section class="doc-section" id="worked">
    <h2>{d.happy.heading}</h2>
    <p>{d.happy.body}</p>
    <p>
      <a class="btn btn-ink" href={REVIEWS_URL} target="_blank" rel="noopener">{d.happy.cta}</a>
    </p>
  </section>

  <section class="doc-section" id="broken">
    <h2>{d.broken.heading}</h2>
    <p>{d.broken.body}</p>
    <form id="feedback-form" data-email={SUPPORT_EMAIL} data-locale={locale}>
      <textarea
        id="feedback-text"
        rows="5"
        required
        maxlength="4000"
        placeholder={d.broken.placeholder}
        aria-label={d.broken.heading}></textarea>
      {/* Optional, and labelled as optional: a reply address is the only way
          to answer a bug report, and no reason to refuse an anonymous one. */}
      <p class="field">
        <label for="feedback-contact">{d.broken.contactLabel}</label>
        <input id="feedback-contact" type="email" maxlength="200" autocomplete="email" />
      </p>
      <p>
        <button class="btn btn-quiet" type="submit">{d.broken.cta}</button>
      </p>
      <p id="feedback-error" class="feedback-error" role="alert" hidden>
        {d.broken.failed} <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>
      </p>
    </form>
    <p class="mail-fallback">
      {d.broken.mailFallback} <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>
    </p>
    <p id="feedback-thanks" hidden>
      {d.broken.thanks}
      <a class="btn btn-quiet" href={REVIEWS_URL} target="_blank" rel="noopener"
        >{d.broken.rateAnyway}</a
      >
    </p>
  </section>

  <p class="doc-section">
    {d.footer}
    <a href={REPO_URL}>github.com/pghqdev/OpenScreenShot</a>
  </p>
</Doc>

<style>
  #feedback-text {
    width: 100%;
    max-width: 560px;
    padding: 12px;
    border: 1px solid var(--border, #d9d4c8);
    border-radius: 10px;
    font: inherit;
    resize: vertical;
  }

  .field {
    display: grid;
    gap: 6px;
    max-width: 560px;
  }

  .field label {
    color: var(--ink-3);
    font-size: var(--fs-sm);
  }

  #feedback-contact {
    padding: 10px 12px;
    border: 1px solid var(--border, #d9d4c8);
    border-radius: 10px;
    font: inherit;
  }

  .mail-fallback,
  .feedback-error {
    color: var(--ink-3);
    font-size: var(--fs-sm);
  }
</style>

<script>
  // One POST to /api/feedback: the text, the version from ?v, this page's
  // locale, and an optional reply address. Nothing else about the visitor
  // exists on this page to send. A failure re-shows the form and points at the
  // mail address rather than swallowing what they wrote — the textarea keeps
  // its contents throughout, so a retry costs nothing.
  const form = document.getElementById('feedback-form') as HTMLFormElement;
  const text = document.getElementById('feedback-text') as HTMLTextAreaElement;
  const contact = document.getElementById('feedback-contact') as HTMLInputElement;
  const thanks = document.getElementById('feedback-thanks') as HTMLElement;
  const failed = document.getElementById('feedback-error') as HTMLElement;
  const button = form?.querySelector('button[type="submit"]') as HTMLButtonElement;
  const sending = button?.textContent ?? '';

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const message = text?.value.trim() ?? '';
    if (!message) return;
    failed.hidden = true;
    button.disabled = true;

    void fetch('/api/feedback', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        message,
        contact: contact?.value.trim() ?? '',
        version: new URLSearchParams(location.search).get('v') ?? 'unknown',
        locale: form.dataset.locale ?? 'en',
      }),
    })
      .then((res) => {
        if (!res.ok) throw new Error(String(res.status));
        form.hidden = true;
        thanks.hidden = false;
      })
      .catch(() => {
        failed.hidden = false;
        button.disabled = false;
        button.textContent = sending;
      });
  });
</script>
