---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BrandMark from '../components/BrandMark.astro';
import CropMarks from '../components/CropMarks.astro';
import FaqList from '../components/FaqList.astro';
import FrameLabel from '../components/FrameLabel.astro';
import PermissionTable from '../components/PermissionTable.astro';
import { homeFaq } from '../data/faq';
import { installPermissions, recordingPermissions } from '../data/permissions';
import { ld } from '../lib/json-ld';
import hero from '../assets/hero.webp';
import shotCapture from '../assets/shot-2.webp';
import shotEditor from '../assets/shot-3.webp';
import shotExport from '../assets/shot-4.webp';
import shotRecorder from '../assets/shot-5.webp';

const STORE_URL = 'https://chromewebstore.google.com/detail/hdabbojjccojlapnfjpdppcpfcnhgmdp';
const REPO_URL = 'https://github.com/pghqdev/OpenScreenShot';

// Anchors only. A cross-page link here would cost the page its One Page Love
// eligibility; Docs, Roadmap, Support, Privacy and Cool stuff live in the footer.
const navLinks = [
  { href: '#features', label: 'Features' },
  { href: '#screens', label: 'Screens' },
  { href: '#privacy', label: 'Privacy' },
  { href: '#faq', label: 'FAQ' },
];

const DESCRIPTION =
  'Free, open-source Chrome extension for full page, visible area and region screenshots, with an annotation editor, export to PNG, JPEG, WebP or PDF, and a tab recorder. Nothing leaves your machine.';

// The four feature tiles. `glyph` is a decorative line drawing in each tile's
// corner; the list is the content.
const features = [
  {
    kicker: 'Capture',
    title: 'The whole page, or a piece of it.',
    items: [
      'Full page, scrolled and stitched for you',
      'Visible area, in one click',
      'A region you drag, with handles on every corner',
      'A 3, 5 or 10 second delay for menus and hover states',
    ],
    glyph:
      'M14 30v-8a8 8 0 0 1 8-8h8M50 14h8a8 8 0 0 1 8 8v8M66 50v8a8 8 0 0 1-8 8h-8M30 66h-8a8 8 0 0 1-8-8v-8',
  },
  {
    kicker: 'Annotate',
    title: 'Draw on it before you share it.',
    items: [
      'Arrows, boxes, lines, freehand, highlighter and text',
      'Blur, mosaic or an opaque fill over anything private',
      'Step numbers that count up, and a spotlight',
      'Crop, with undo that goes all the way back',
    ],
    glyph: 'M18 62 54 26M48 20l12 12M18 62l4-14 10 10ZM40 60h22',
  },
  {
    kicker: 'Export',
    title: 'Keep it in the format you need.',
    items: [
      'PNG, JPEG or WebP, with a quality slider',
      'PDF, on A4 or Letter, one page or many',
      'Scale to 25, 50, 100 or 200 %, or an exact width',
      'Or copy straight to the clipboard',
    ],
    glyph: 'M40 16v34M26 38l14 14 14-14M18 58v6a4 4 0 0 0 4 4h36a4 4 0 0 0 4-4v-6',
  },
  {
    kicker: 'Record',
    title: 'Record the tab when a still image is not enough.',
    items: [
      'One click starts a tab recording',
      'Auto zoom at every click you make',
      'Your mic and a webcam bubble, if you want them',
      'Trim on a timeline, then export WebM',
    ],
    glyph: 'M40 62a22 22 0 1 0 0-44 22 22 0 0 0 0 44ZM40 48a8 8 0 1 0 0-16 8 8 0 0 0 0 16Z',
  },
];

// The gallery. Every image is a real screenshot of the built extension,
// rendered by scripts/shots/render.mjs.
const screens = [
  {
    image: shotCapture,
    title: 'Region capture',
    caption: 'Drag a region. Handles on every corner, and the size shown live.',
    alt: 'A region selection in progress on a web page in Chrome: a dashed rectangle with corner handles, a 516 by 300 size readout, and Capture and Cancel buttons.',
  },
  {
    image: shotEditor,
    title: 'The editor',
    caption: 'A box and an arrow on a full page capture, with the Poster look applied.',
    alt: 'The OpenScreenShot editor with its tool rail, color palette and stroke controls, showing a full page screenshot with a box and an arrow drawn on it.',
  },
  {
    image: shotExport,
    title: 'Export',
    caption: 'Four formats, a scale control, and a filename you set once.',
    alt: 'The export dialog in the OpenScreenShot editor, with PNG selected, JPEG, WebP and PDF beside it, a scale row, a width field and a filename field.',
  },
  {
    image: shotRecorder,
    title: 'The recorder',
    caption: 'Two auto zoom blocks on the timeline, cursor options, and Export WebM.',
    alt: 'The OpenScreenShot recorder with a recorded page in the preview, cursor and tab volume controls, and a timeline with two 2x zoom blocks.',
  },
];

// What the extension does not have. Each row is a claim the privacy section
// and the store listing both make.
const receipt = [
  { k: 'Account', v: 'None' },
  { k: 'Upload', v: 'None' },
  { k: 'Telemetry', v: 'None' },
  { k: 'Watermark', v: 'None' },
  { k: 'Host permissions at install', v: 'None' },
  { k: 'License', v: 'MIT' },
];

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'OpenScreenShot',
  applicationCategory: 'BrowserApplication',
  operatingSystem: 'Chrome',
  description: DESCRIPTION,
  url: 'https://openscreenshot.app/',
  downloadUrl: STORE_URL,
  softwareVersion: '1.5.0',
  license: `${REPO_URL}/blob/main/LICENSE`,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: 'PGHQ.dev', url: 'https://github.com/pghqdev' },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

// The <details> below and mainEntity above both read homeFaq, so they cannot
// drift. This guard fails the build if a later edit gives either its own source.
if (faqLd.mainEntity.length !== homeFaq.length) {
  throw new Error(
    `FAQ drift: ${faqLd.mainEntity.length} structured answers for ${homeFaq.length} rendered questions.`,
  );
}

---

<Base
  title="Full Page Screenshot & Editor for Chrome — OpenScreenShot"
  description={DESCRIPTION}
  path="/"
  navLinks={navLinks}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={ld(softwareLd)} />
    <script type="application/ld+json" set:html={ld(faqLd)} />
  </Fragment>

  <!-- Hero -->
  <section id="top" class="hero">
    <div class="container-wide">
      <p class="pill"><span class="pill-dot" aria-hidden="true"></span>Free and open source · MIT</p>
      <h1>
        Full page screenshots for Chrome.<br />
        <span class="muted">Nothing leaves your machine.</span>
      </h1>
      <div class="hero-row">
        <p class="cta-row">
          <a class="btn btn-ink" href={STORE_URL} target="_blank" rel="noopener">Add to Chrome</a>
          <a class="btn btn-quiet" href={REPO_URL} target="_blank" rel="noopener">
            View on GitHub ↗
          </a>
        </p>
        <p class="sub">
          Capture the whole page, the visible area, or a region. Draw on it, then export PNG, JPEG,
          WebP or PDF. Record the tab when a still image is not enough. No account, no upload, no
          watermark.
        </p>
      </div>
    </div>
    <div class="container-hero">
      <figure class="hero-shot">
        <Picture
          src={hero}
          alt="The OpenScreenShot popup open over a web page in Chrome, with Full Page, Visible Area, Selected Region and Record options."
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[640, 960, 1280, 1800, 2400]}
          sizes="(min-width: 1248px) 1200px, 100vw"
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- Proof. site-worker.js rewrites the two data-stat elements at the edge;
       the numbers here are the fallback when shields.io is unreachable. -->
  <section class="proof-strip" aria-label="In numbers">
    <ul class="container-wide proof">
      <li><b data-stat="users">985</b> users on the Chrome Web Store</li>
      <li><b data-stat="stars">65</b> stars on GitHub</li>
      <li>MIT licensed</li>
      <li>Works offline</li>
    </ul>
  </section>

  <!-- Features -->
  <section id="features" class="section">
    <div class="container-wide">
      <FrameLabel label="What it does" />
      <h2>Capture, annotate, export, record. <span class="muted">All of it in your browser.</span></h2>
      <ul class="features">
        {
          features.map((f) => (
            <li class="card feature">
              <svg class="feature-glyph" viewBox="0 0 80 80" aria-hidden="true" focusable="false">
                <path d={f.glyph} />
              </svg>
              <p class="feature-kicker">{f.kicker}</p>
              <h3>{f.title}</h3>
              <ul class="feature-list">
                {f.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Screens -->
  <section id="screens" class="section">
    <div class="container-wide">
      <FrameLabel label="In use" />
      <h2>The extension at work. <span class="muted">Real screenshots of the build.</span></h2>
      <ul class="gallery">
        {
          screens.map((s) => (
            <li>
              <figure class="screen">
                <div class="card screen-tile">
                  <Picture
                    src={s.image}
                    alt={s.alt}
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    widths={[480, 900, 1350, 1800]}
                    sizes="(min-width: 900px) 520px, 100vw"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <figcaption>
                  <b>{s.title}</b>
                  <span>{s.caption}</span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Privacy -->
  <section id="privacy" class="section">
    <div class="container-wide split">
      <div>
        <FrameLabel label="Privacy" />
        <h2>Everything stays on your device.</h2>
        <p class="lede">
          Screenshots are often the most sensitive images on your machine. Capture, editing, export,
          PDF and recording all run in your browser. The extension makes no network request of its
          own. Its host permissions are empty, so it has no standing access to any site you visit.
        </p>
      </div>
      <dl class="card receipt">
        {
          receipt.map((row) => (
            <div>
              <dt>{row.k}</dt>
              <dd>{row.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="container-wide">
      <h3 class="sub-head">What it asks for at install</h3>
      <PermissionTable rows={installPermissions} />

      <h3 class="sub-head">What recording adds, only when you record</h3>
      <PermissionTable rows={recordingPermissions} />

      <p class="fine">
        The microphone and camera, when you enable them, are opened by your browser’s own permission
        prompt. The stream never leaves your device.
      </p>
    </div>
  </section>

  <!-- Agents & CLI -->
  <section id="agents-cli" class="section">
    <div class="container-wide">
      <FrameLabel label="Agents & CLI" />
      <h2>Scriptable, from a terminal. <span class="muted">Still local.</span></h2>
      <div class="card cli">
        <div class="cli-about">
          <p class="cli-name"><code>openscreenshot</code> on npm</p>
          <ul>
            <li>A separate, optional tool for scripts and AI agents</li>
            <li>Drives the Chrome already on your machine</li>
            <li>No browser download, no hosted service</li>
            <li>Also an MCP server, with a <code>capture_screenshot</code> tool</li>
          </ul>
        </div>
        <div class="cli-code">
          <p class="cli-label">One screenshot</p>
          <pre class="code"><code>npx openscreenshot shot https://example.com --out shot.png --full</code></pre>
          <p class="cli-label">MCP client config</p>
          <pre class="code"><code>{'{ "command": "npx", "args": ["openscreenshot", "serve"] }'}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section">
    <div class="container-wide">
      <FrameLabel label="FAQ" />
      <h2>Questions.</h2>
      <FaqList items={homeFaq} />
      <p class="fine">
        Every question, plus the known limits, on the <a href="/support/">Support page</a>.
      </p>
    </div>
  </section>

  <!-- Final CTA -->
  <section id="download" class="section cta-final">
    <div class="container">
      <CropMarks arm="30px" inset="22px">
        <div class="cta-mark"><BrandMark size={44} /></div>
        <h2>Add it to Chrome.</h2>
        <p class="lede">Free, open source and offline. Installed in seconds.</p>
        <p class="cta-row">
          <a class="btn btn-ink" href={STORE_URL} target="_blank" rel="noopener">Add to Chrome</a>
        </p>
        <p class="fine">Works on Chrome, Edge, Brave, Arc and other Chromium browsers.</p>
      </CropMarks>
    </div>
  </section>

  <Fragment slot="body-end">
    <script is:inline src="/assets/webmcp.js" defer></script>
  </Fragment>
</Base>

<style>
  /* ---- Rhythm ---- */

  .section {
    padding-block: clamp(64px, 9vw, 128px);
  }

  .section h2 {
    max-width: 30ch;
    margin-bottom: var(--s-6);
    font-size: var(--fs-title);
  }

  .fine {
    max-width: var(--max-w);
    color: var(--ink-3);
    font-size: var(--fs-sm);
  }

  .container-hero {
    max-width: var(--max-w-hero);
    margin-inline: auto;
    padding-inline: var(--s-5);
  }

  /* ---- Hero ---- */

  .hero {
    padding-top: clamp(40px, 7vw, 96px);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-bottom: var(--s-5);
    padding: 6px 14px 6px 10px;
    border: 1px solid var(--rule);
    border-radius: var(--r-full);
    background: var(--paper-raised);
    color: var(--ink-2);
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .pill-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .hero h1 {
    margin-bottom: var(--s-6);
    font-size: var(--fs-hero);
    line-height: 1.04;
  }

  .hero-row {
    display: grid;
    gap: var(--s-5);
    align-items: start;
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    margin: 0;
  }

  .sub {
    max-width: 44ch;
    margin: 0;
    color: var(--ink-2);
    font-size: var(--fs-lg);
  }

  .hero-shot {
    margin: 0;
    border: 1px solid var(--rule);
    border-radius: var(--r-xl);
    overflow: hidden;
    box-shadow: var(--sh-card);
  }

  .hero-shot img {
    width: 100%;
  }

  @media (min-width: 760px) {
    .hero-row {
      grid-template-columns: auto 1fr;
      gap: var(--s-7);
    }
  }

  /* ---- Proof strip ---- */

  .proof-strip {
    margin-top: clamp(32px, 5vw, 64px);
    border-block: 1px solid var(--rule);
  }

  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
    margin-block: 0;
    padding-block: var(--s-4);
    list-style: none;
    color: var(--ink-3);
    font-size: var(--fs-md);
  }

  .proof b {
    color: var(--ink);
    font-weight: 600;
  }

  /* ---- Features ---- */

  .features {
    display: grid;
    gap: var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feature {
    position: relative;
    padding: var(--s-6);
    overflow: hidden;
  }

  .feature-glyph {
    position: absolute;
    top: -10px;
    right: -6px;
    width: 128px;
    height: 128px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.16;
  }

  .feature-kicker {
    margin-bottom: var(--s-3);
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
  }

  .feature h3 {
    max-width: 18ch;
    margin-bottom: var(--s-4);
    font-size: var(--fs-xl);
  }

  .feature-list {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
    font-size: var(--fs-md);
  }

  .feature-list li,
  .cli-about li {
    position: relative;
    padding-left: var(--s-5);
  }

  .feature-list li::before,
  .cli-about li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (min-width: 720px) {
    .features {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ---- Gallery ---- */

  .gallery {
    display: grid;
    gap: var(--s-6) var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .screen {
    margin: 0;
  }

  .screen-tile {
    overflow: hidden;
  }

  .screen-tile img {
    width: 100%;
  }

  .screen figcaption {
    display: grid;
    gap: 2px;
    margin-top: var(--s-4);
    color: var(--ink-3);
    font-size: var(--fs-md);
  }

  .screen figcaption b {
    color: var(--ink);
    font-weight: 600;
  }

  @media (min-width: 720px) {
    .gallery {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ---- Privacy ---- */

  .split {
    display: grid;
    gap: var(--s-6);
    align-items: start;
    margin-bottom: var(--s-7);
  }

  .split .lede {
    margin: 0;
  }

  .receipt {
    margin: 0;
    padding: var(--s-3) var(--s-6);
  }

  .receipt > div {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: var(--s-3);
    border-top: 1px solid var(--rule);
  }

  .receipt > div:first-child {
    border-top: 0;
  }

  .receipt dt {
    color: var(--ink-2);
    font-size: var(--fs-md);
  }

  .receipt dd {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .sub-head {
    margin-top: var(--s-6);
  }

  @media (min-width: 860px) {
    .split {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--s-8);
    }
  }

  /* ---- Agents & CLI ---- */

  .cli {
    display: grid;
    overflow: hidden;
  }

  .cli-about {
    padding: var(--s-6);
    background: var(--paper-dim);
  }

  .cli-name {
    margin-bottom: var(--s-4);
    color: var(--ink);
    font-weight: 600;
  }

  .cli-about ul {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
    font-size: var(--fs-md);
  }

  .cli-code {
    padding: var(--s-6);
  }

  .cli-label {
    margin-bottom: var(--s-2);
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
  }

  .code {
    margin: 0 0 var(--s-5);
    padding: var(--s-4);
    border-radius: var(--r-md);
    background: var(--slab);
    color: var(--slab-ink);
    font-size: var(--fs-sm);
    overflow-x: auto;
  }

  .code:last-child {
    margin-bottom: 0;
  }

  .code code {
    font-size: inherit;
  }

  @media (min-width: 860px) {
    .cli {
      grid-template-columns: 2fr 3fr;
    }
  }

  /* ---- Final CTA ---- */

  .cta-final {
    text-align: center;
  }

  .cta-final h2 {
    margin-inline: auto;
  }

  .cta-final .lede,
  .cta-final .fine {
    margin-inline: auto;
  }

  .cta-final .cta-row {
    justify-content: center;
    margin-bottom: var(--s-4);
  }

  /* The mark is a child component's root, out of reach of a scoped selector,
   * so the wrapper centres it. */
  .cta-mark {
    display: flex;
    justify-content: center;
    margin-bottom: var(--s-4);
  }
</style>
