---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BrandMark from '../components/BrandMark.astro';
import CropMarks from '../components/CropMarks.astro';
import FaqList from '../components/FaqList.astro';
import Frame from '../components/Frame.astro';
import FrameLabel from '../components/FrameLabel.astro';
import PermissionTable from '../components/PermissionTable.astro';
import { homeFaq } from '../data/faq';
import { installPermissions, recordingPermissions } from '../data/permissions';
import { ld } from '../lib/json-ld';
import hero from '../assets/hero.webp';
import shotCapture from '../assets/shot-2.webp';
import shotAnnotate from '../assets/shot-3.webp';
import shotExport from '../assets/shot-4.webp';
import shotRecord from '../assets/shot-5.webp';

const STORE_URL = 'https://chromewebstore.google.com/detail/hdabbojjccojlapnfjpdppcpfcnhgmdp';
const REPO_URL = 'https://github.com/pghqdev/OpenScreenShot';

// Anchors only. A cross-page link here would cost the page its One Page Love
// eligibility; Docs, Roadmap, Support, Privacy and Cool stuff live in the footer.
const navLinks = [
  { href: '#capture', label: 'Capture' },
  { href: '#annotate', label: 'Annotate' },
  { href: '#record', label: 'Record' },
  { href: '#privacy', label: 'Privacy' },
  { href: '#faq', label: 'FAQ' },
];

// The ticker is one run repeated twice so the loop is seamless.
const ticker =
  'FULL PAGE · REGION · VISIBLE AREA · ARROWS · BLUR · SPOTLIGHT · STEP NUMBERS · CROP · PNG · JPEG · WEBP · PDF · TAB RECORDING · CLIPBOARD · MIT LICENSED · NO ACCOUNT · NO UPLOAD · ';

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'OpenScreenShot',
  applicationCategory: 'BrowserApplication',
  operatingSystem: 'Chrome',
  description:
    'Free, open-source Chrome extension for full-page, region, and visible-area screenshots, with a built-in annotation editor and export to PNG, JPEG, WebP, or PDF. All processing stays on your device.',
  url: 'https://openscreenshot.app/',
  downloadUrl: STORE_URL,
  softwareVersion: '1.5.0',
  license: `${REPO_URL}/blob/main/LICENSE`,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: 'PGHQ.dev', url: 'https://github.com/pghqdev' },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

// The <details> below and mainEntity above both read homeFaq, so they cannot
// drift. This guard fails the build if a later edit gives either its own source.
if (faqLd.mainEntity.length !== homeFaq.length) {
  throw new Error(
    `FAQ drift: ${faqLd.mainEntity.length} structured answers for ${homeFaq.length} rendered questions.`,
  );
}

---

<Base
  title="Full Page Screenshot & Editor for Chrome — OpenScreenShot"
  description="Free, open-source full page screenshot extension for Chrome. Capture the entire scrolling page, annotate it, and export to PNG, JPEG, WebP, or PDF. Fully local."
  path="/"
  navLinks={navLinks}
  preloadItalic
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={ld(softwareLd)} />
    <script type="application/ld+json" set:html={ld(faqLd)} />
  </Fragment>

  <!-- Hero -->
  <section id="top" class="section hero">
    <div class="container-wide">
      <FrameLabel label="Full page screenshot for Chrome · Actually free" />
      <h1>
        No account. No watermark.<br />
        <em>No catch.</em>
      </h1>
      <p class="sub">
        Other screenshot tools want your email. Or your history. Or a logo in your corner. This one
        takes the whole page, lets you draw on it, and hands it back. Actually free. Open source.
        Offline.
      </p>
      <p class="cta-row">
        <a class="btn btn-ink" href={STORE_URL} target="_blank" rel="noopener">
          Add to Chrome — Free
        </a>
        <a class="btn btn-quiet" href={REPO_URL} target="_blank" rel="noopener">Read the code ↗</a>
      </p>
      <p class="note">Actually free. No trial. No pro tier. No upsell.</p>

      <div class="shot-wrap">
        <CropMarks arm="26px" inset="14px">
          <div class="slab">
            <Picture
              src={hero}
              alt="The OpenScreenShot popup open over a web page, offering Full page, Visible area, and Region capture, with a region selection in progress."
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[600, 900, 1400, 2320]}
              sizes="(min-width: 900px) 980px, 100vw"
              fetchpriority="high"
              loading="eager"
              decoding="async"
            />
          </div>
        </CropMarks>
      </div>
    </div>
  </section>

  <!-- Ticker -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      <span class="ticker-run">{ticker}</span>
      <span class="ticker-run">{ticker}</span>
    </div>
  </div>

  <!-- Frame 01 -->
  <Frame
    id="capture"
    index="01"
    label="Capture"
    title="Take the whole page."
    lede="Full page, visible area, or a region you drag. Start from the popup, a keyboard shortcut, or the right-click menu. Full-page capture scrolls, tiles and stitches the page for you, and a progress bar tells you where it is."
    spec={[
      { dt: 'Ctrl+Shift+S', dd: 'the whole scrolling page, header and all' },
      { dt: 'Ctrl+Shift+E', dd: 'a dragged region, with resize handles on every edge' },
      { dt: 'Delay 3s', dd: 'hold a menu or a hover state open, then capture it' },
    ]}
    image={shotCapture}
    alt="A tall article strip marked with two stitch seams, beside the assembled full-page screenshot in a browser frame."
  />

  <!-- Frame 02 -->
  <Frame
    id="annotate"
    index="02"
    label="Annotate"
    title="Draw on it."
    lede="Arrows, boxes, lines, freehand, highlighter and text. Every tool has a one-letter key, an 8-color palette on 1–8, and undo that goes all the way back. Drop in an image you already have and the same tools work on it."
    spec={[
      { dt: 'B', dd: 'blur, mosaic, or an opaque fill that survives recompression' },
      { dt: 'S', dd: 'step numbers that count up, and renumber when you delete one' },
      { dt: 'O', dd: 'spotlight cut-outs that merge into one dim layer' },
    ]}
    image={shotAnnotate}
    alt="The OpenScreenShot annotation editor with its toolbar, style bar, and export controls called out."
  />

  <!-- Frame 03 -->
  <Frame
    id="export"
    index="03"
    label="Export"
    title="Keep it, in your format."
    lede="PNG, JPEG, WebP or PDF. Scale to 25, 50, 100 or 200 %, or to an exact pixel width. Beautify adds padding, rounded corners, a shadow and a background, and that frame travels into every export."
    spec={[
      { dt: 'PDF', dd: 'one page, fit to A4 or Letter, or split with a 5 mm overlap' },
      { dt: 'Ctrl+C', dd: 'the finished image, straight to the clipboard' },
      { dt: '{date} {title} {domain}', dd: 'filename tokens you set once, with a live preview' },
    ]}
    image={shotExport}
    alt="The four OpenScreenShot export formats — PNG, JPEG, WebP and PDF — each with its own card."
  />

  <!-- Frame 04 -->
  <Frame
    id="record"
    index="04"
    label="Record"
    title="Record the tab too."
    lede="One click starts a tab recording, with your mic, the tab’s audio and a draggable webcam bubble if you want them. Stop opens a timeline editor that zooms to every click you made. Export writes a WebM."
    spec={[
      { dt: 'Alt+Shift+X', dd: 'stop the recording from anywhere' },
      { dt: 'IndexedDB', dd: 'chunks written as you record, so a crash keeps the take' },
      { dt: 'tabCapture', dd: 'optional, asked once, at your first recording' },
    ]}
    image={shotRecord}
    alt="OpenScreenShot's tab recording feature: one-click start, webcam bubble, timeline editor, and WebM export."
  />

  <!-- Proof strip. Task 7's Worker rewrites the two data-stat elements at the
       edge; the numbers here are the fallback when shields.io is unreachable. -->
  <section class="proof-strip">
    <div class="container-wide">
      <p class="proof">
        <span><b data-stat="users">985</b> users</span>
        <span class="proof-sep" aria-hidden="true">·</span>
        <span><b data-stat="stars">65</b> stars</span>
        <span class="proof-sep" aria-hidden="true">·</span>
        <span>MIT</span>
      </p>
    </div>
  </section>

  <!-- Actually free -->
  <section id="free" class="section reveal">
    <div class="container-wide">
      <FrameLabel label="Actually free" />
      <h2>Actually free.</h2>
      <p class="lede">
        Every feature, every export format, every recording. There is nothing behind a paywall,
        because there is no paywall.
      </p>
      <ul class="cards">
        <li>
          <h3>Free</h3>
          <p>No trial, no pro tier, no upsell. Nothing expires and there is nothing to cancel.</p>
        </li>
        <li>
          <h3>Open</h3>
          <p>MIT licensed. Every line is on GitHub, and you can build it yourself in a minute.</p>
        </li>
        <li>
          <h3>Yours</h3>
          <p>No account, no sign-in, no email. Your screenshots carry no watermark out.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- Privacy -->
  <section id="privacy" class="section reveal">
    <div class="container-wide">
      <FrameLabel label="Privacy" />
      <h2>Everything stays on your device.</h2>
      <p class="lede">
        Screenshots are often the most sensitive images on your machine. Capture, editing, export
        and PDF all run in your browser. The extension makes no network request of its own. Its host
        permissions are empty, so it has no standing access to any site you visit.
      </p>

      <h3 class="sub-head">What it asks for at install</h3>
      <PermissionTable rows={installPermissions} />

      <h3 class="sub-head">What recording adds, only when you record</h3>
      <PermissionTable rows={recordingPermissions} />

      <p class="fine">
        The microphone and camera, when you enable them, are opened by your browser’s own permission
        prompt. The stream never leaves your device.
      </p>
    </div>
  </section>

  <!-- Agents & CLI -->
  <section id="agents-cli" class="section reveal">
    <div class="container-wide">
      <FrameLabel label="Agents & CLI" />
      <h2>Scriptable, from a terminal.</h2>
      <p class="lede">
        <code>openscreenshot</code> on npm is a separate, optional, local tool for scripting
        screenshots from the command line or from an AI agent. It drives the Chrome already on your
        machine. No browser download, no hosted service.
      </p>
      <pre class="code"><code>npx openscreenshot shot https://example.com --out shot.png --full</code></pre>
      <p>As an MCP server, add this to your MCP client config:</p>
      <pre class="code"><code>{'{ "command": "npx", "args": ["openscreenshot", "serve"] }'}</code></pre>
      <p class="fine">
        Then call the <code>capture_screenshot</code> tool with{' '}
        <code>{'{ "url": "https://example.com" }'}</code>.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section reveal">
    <div class="container-wide">
      <FrameLabel label="FAQ" />
      <h2>Questions.</h2>
      <FaqList items={homeFaq} />
      <p class="fine">
        Every question, plus the known limits, on the <a href="/support/">Support page</a>.
      </p>
    </div>
  </section>

  <!-- Final CTA -->
  <section id="download" class="section cta-final">
    <div class="container">
      <CropMarks arm="30px" inset="22px">
        <div class="cta-mark"><BrandMark size={40} /></div>
        <h2>Add it to Chrome.</h2>
        <p class="lede">Free, open source and offline. Installed in seconds.</p>
        <p class="cta-row">
          <a class="btn btn-ink" href={STORE_URL} target="_blank" rel="noopener">
            Add to Chrome — Free
          </a>
        </p>
        <p class="fine">Works on Chrome, Edge, Brave, Arc and other Chromium browsers.</p>
      </CropMarks>
    </div>
  </section>

  <Fragment slot="body-end">
    <script is:inline src="/assets/webmcp.js" defer></script>
  </Fragment>
</Base>

<style>
  /* ---- Section rhythm ---- */

  .section {
    padding-block: var(--s-8);
  }

  .section + .section {
    border-top: 1px solid var(--rule);
  }

  .fine {
    max-width: var(--max-w);
    color: var(--ink-3);
    font-size: var(--fs-sm);
  }

  /* ---- Hero ---- */

  .hero {
    padding-top: var(--s-7);
  }

  .hero h1 {
    margin-bottom: var(--s-5);
  }

  .hero h1 em {
    color: var(--accent);
  }

  .sub {
    max-width: 46ch;
    font-size: var(--fs-lg);
    color: var(--ink-2);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-3);
  }

  /* Sentence case, as the copy block sets it. The eyebrow above the h1 and the
   * proof strip below already carry the hero's caps voice. --tr-label goes with
   * it: that tracking is drawn for caps and gaps in lower case. */
  .note {
    margin-bottom: var(--s-7);
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--fs-xs);
  }

  /* ---- Product slab ---- */

  .shot-wrap {
    margin-inline: var(--s-3);
  }

  /* ---- Ticker ---- */

  .ticker {
    padding-block: var(--s-3);
    border-block: 1px solid var(--rule);
    overflow: hidden;
  }

  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker-scroll 48s linear infinite;
  }

  .ticker-run {
    padding-right: 0.6em;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--fs-xs);
    letter-spacing: var(--tr-label);
    white-space: nowrap;
  }

  @keyframes ticker-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  /* ---- Proof strip ---- */

  .proof-strip {
    padding-block: var(--s-6);
    background: var(--paper-dim);
    border-block: 1px solid var(--rule);
  }

  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    margin: 0;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--fs-md);
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
  }

  .proof b {
    color: var(--accent-ink);
    font-weight: 500;
  }

  .proof-sep {
    color: var(--ink-3);
  }

  /* ---- Cards ---- */

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--s-5);
    margin: var(--s-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .cards li {
    padding: var(--s-5);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--paper-raised);
  }

  .cards h3 {
    margin-bottom: var(--s-2);
    font-size: var(--fs-xl);
  }

  .cards p {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--fs-md);
  }

  /* ---- Permission tables ---- */

  .sub-head {
    margin-top: var(--s-6);
  }

  /* ---- Code blocks ---- */

  .code {
    max-width: var(--max-w);
    margin: var(--s-4) 0;
    padding: var(--s-4);
    border-radius: var(--r-md);
    background: var(--slab);
    color: var(--slab-ink);
    font-size: var(--fs-sm);
    overflow-x: auto;
  }

  .code code {
    font-size: inherit;
  }

  /* ---- Final CTA ---- */

  .cta-final {
    text-align: center;
  }

  .cta-final .lede,
  .cta-final .fine {
    margin-inline: auto;
  }

  .cta-final .cta-row {
    justify-content: center;
  }

  /* The mark is a child component's root, out of reach of a scoped selector,
   * so the wrapper centres it. */
  .cta-mark {
    display: flex;
    justify-content: center;
    margin-bottom: var(--s-4);
  }
</style>
