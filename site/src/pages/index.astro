---
// Placeholder homepage. Task 3 replaces this with the real landing page.
import Base from '../layouts/Base.astro';
import FrameLabel from '../components/FrameLabel.astro';
import CropMarks from '../components/CropMarks.astro';

const navLinks = [
  { href: '#capture', label: 'Capture' },
  { href: '#annotate', label: 'Annotate' },
];
---

<Base
  title="OpenScreenShot"
  description="Free, open-source full page screenshot extension for Chrome."
  path="/"
  navLinks={navLinks}
  preloadItalic
>
  <div class="container">
    <CropMarks>
      <FrameLabel index="01" label="Capture" />
      <h1>OpenScreenShot</h1>
    </CropMarks>
  </div>
</Base>
