---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ChromeIcon from '../components/ChromeIcon.astro';
import FaqList from '../components/FaqList.astro';
import PermissionTable from '../components/PermissionTable.astro';
import { homeFaq } from '../data/faq';
import { installPermissions, recordingPermissions } from '../data/permissions';
import { ld } from '../lib/json-ld';
import hero from '../assets/hero.webp';
import shotCapture from '../assets/shot-2.webp';
import shotEditor from '../assets/shot-3.webp';
import shotExport from '../assets/shot-4.webp';
import shotRecorder from '../assets/shot-5.webp';

const STORE_URL = 'https://chromewebstore.google.com/detail/hdabbojjccojlapnfjpdppcpfcnhgmdp';
const REPO_URL = 'https://github.com/pghqdev/OpenScreenShot';

// The homepage nav is the reference's minimal pair: brand left, install pill
// right, nothing between. Cross-page links live in the footer, which also
// keeps the page's One Page Love eligibility. Section ids stay for deep links.

const DESCRIPTION =
  'Free, open-source Chrome extension for full page, visible area and region screenshots, with an annotation editor, export to PNG, JPEG, WebP or PDF, and a tab recorder. Nothing leaves your machine.';

// The in-house line icon set: one 24px grid, one stroke, coral only.
const icons = {
  capture:
    'M8 4H6a2 2 0 0 0-2 2v2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2M14.4 12a2.4 2.4 0 1 1-4.8 0 2.4 2.4 0 0 1 4.8 0Z',
  pen: 'm4 20 1.2-4.2L16.7 4.3a2.05 2.05 0 0 1 2.9 2.9L8.2 18.8 4 20ZM13.5 6.5l3 3',
  export: 'M12 4v11M7 10.5l5 5 5-5M4.5 19.5h15',
  record: 'M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
  lock: 'M7 11V8a5 5 0 0 1 10 0v3M6.5 11h11a1.5 1.5 0 0 1 1.5 1.5v6A1.5 1.5 0 0 1 17.5 20h-11A1.5 1.5 0 0 1 5 18.5v-6A1.5 1.5 0 0 1 6.5 11Z',
  terminal: 'm5 7 5 5-5 5M12.5 17H19',
};

// The hero's tabbed showcase: one framed stage, four screens.
const heroTabs = [
  {
    id: 'capture',
    label: 'Capture',
    image: hero,
    alt: 'The OpenScreenShot popup open over a web page in Chrome, with Full Page, Visible Area, Selected Region and Record options.',
  },
  {
    id: 'annotate',
    label: 'Annotate',
    image: shotEditor,
    alt: 'The OpenScreenShot editor with its tool rail, color palette and stroke controls, showing a full page capture of opentechcheck.com with a box and an arrow drawn on it.',
  },
  {
    id: 'export',
    label: 'Export',
    image: shotExport,
    alt: 'The export dialog in the OpenScreenShot editor, with PNG selected, JPEG, WebP and PDF beside it, a scale row, a width field and a filename field.',
  },
  {
    id: 'record',
    label: 'Record',
    image: shotRecorder,
    alt: 'The OpenScreenShot recorder with a recorded page in the preview, cursor and tab volume controls, and a timeline with two 2x zoom blocks.',
  },
];

// The trio under the hero: the three reasons to install, benefit first.
const trio = [
  {
    icon: icons.capture,
    title: 'Capture anything',
    body: 'The whole page, the visible area, or a region you drag. One click, a shortcut, or the right-click menu.',
  },
  {
    icon: icons.pen,
    title: 'Edit before you share',
    body: 'Arrows, boxes and text to make your point. Blur for the parts nobody else should see.',
  },
  {
    icon: icons.lock,
    title: 'Private by default',
    body: 'No account, no upload, no telemetry. It works with your Wi-Fi off.',
  },
];

// The four alternating feature sections. Every image is a real screenshot of
// the built extension, rendered by scripts/shots/render.mjs.
const features = [
  {
    id: 'features',
    kicker: 'Capture',
    icon: icons.capture,
    title: 'Grab exactly what you need.',
    items: [
      'Full page, scrolled and stitched for you',
      'Visible area, in one click',
      'A region you drag, with handles on every corner',
      'A 3, 5 or 10 second delay for menus and hover states',
    ],
    image: shotCapture,
    alt: 'A region selection in progress on opentechcheck.com in Chrome: a dashed rectangle with corner handles, a 420 by 300 size readout, and Capture and Cancel buttons.',
  },
  {
    id: 'editor',
    kicker: 'Annotate',
    icon: icons.pen,
    title: 'Make your point before you share.',
    items: [
      'Arrows, boxes, lines, freehand, highlighter and text',
      'Blur, mosaic or an opaque fill over anything private',
      'Step numbers that count up, and a spotlight',
      'Crop, with undo that goes all the way back',
    ],
    image: shotEditor,
    alt: 'The OpenScreenShot editor with its tool rail, color palette and stroke controls, showing a full page capture of opentechcheck.com with a box and an arrow drawn on it.',
  },
  {
    id: 'export',
    kicker: 'Export',
    icon: icons.export,
    title: 'Leave in the format you need.',
    items: [
      'PNG, JPEG or WebP, with a quality slider',
      'PDF, on A4 or Letter, one page or many',
      'Scale to 25, 50, 100 or 200 %, or an exact width',
      'Or copy straight to the clipboard',
    ],
    image: shotExport,
    alt: 'The export dialog in the OpenScreenShot editor, with PNG selected, JPEG, WebP and PDF beside it, a scale row, a width field and a filename field.',
  },
  {
    id: 'recorder',
    kicker: 'Record',
    icon: icons.record,
    title: 'When a picture is not enough, record it.',
    items: [
      'One click starts a tab recording',
      'Auto zoom at every click you make',
      'Your mic and a webcam bubble, if you want them',
      'Trim on a timeline, then export WebM',
    ],
    image: shotRecorder,
    alt: 'The OpenScreenShot recorder with a recorded page in the preview, cursor and tab volume controls, and a timeline with two 2x zoom blocks.',
  },
];

// What the extension does not have. Each row is a claim the privacy section
// and the store listing both make.
const receipt = [
  { k: 'Account', v: 'None' },
  { k: 'Upload', v: 'None' },
  { k: 'Telemetry', v: 'None' },
  { k: 'Watermark', v: 'None' },
  { k: 'Host permissions at install', v: 'None' },
  { k: 'License', v: 'MIT' },
];

// The closing three steps.
const steps = [
  {
    title: 'Add it to Chrome',
    body: 'One click on the Chrome Web Store. Free, and no sign-up.',
  },
  {
    title: 'Click the icon',
    body: 'Or press the shortcut. Pick full page, visible area, or a region.',
  },
  {
    title: 'Capture',
    body: 'Annotate, export, or copy. It never leaves your machine.',
  },
];

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'OpenScreenShot',
  applicationCategory: 'BrowserApplication',
  operatingSystem: 'Chrome',
  description: DESCRIPTION,
  url: 'https://openscreenshot.app/',
  downloadUrl: STORE_URL,
  softwareVersion: '1.5.0',
  license: `${REPO_URL}/blob/main/LICENSE`,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: 'PGHQ.dev', url: 'https://github.com/pghqdev' },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

// The <details> below and mainEntity above both read homeFaq, so they cannot
// drift. This guard fails the build if a later edit gives either its own source.
if (faqLd.mainEntity.length !== homeFaq.length) {
  throw new Error(
    `FAQ drift: ${faqLd.mainEntity.length} structured answers for ${homeFaq.length} rendered questions.`,
  );
}
---

<Base
  title="Full Page Screenshot & Editor for Chrome — OpenScreenShot"
  description={DESCRIPTION}
  path="/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={ld(softwareLd)} />
    <script type="application/ld+json" set:html={ld(faqLd)} />
  </Fragment>

  <!-- Hero -->
  <section id="top" class="hero">
    <div class="container-wide hero-copy">
      <p class="hero-note">Free · Open source · MIT licensed</p>
      <h1>Capture the whole page.<br />Keep it to yourself.</h1>
      <p class="sub">
        Screenshots, markup, export, and tab recording — all inside Chrome. Nothing is ever
        uploaded.
      </p>
      <p class="cta-row">
        <a class="btn btn-ink" href={STORE_URL} target="_blank" rel="noopener">
          <ChromeIcon size={18} />
          Add to Chrome
        </a>
        <a class="btn btn-quiet" href={REPO_URL} target="_blank" rel="noopener">
          <svg class="gh-mark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path>
          </svg>
          View on GitHub
        </a>
      </p>
    </div>
    <div class="container-hero">
      <div class="hero-frame">
        <div class="hero-tabs" role="tablist" aria-label="The extension's screens">
          <span class="hero-tabs-thumb" aria-hidden="true"></span>
          {
            heroTabs.map((tab, i) => (
              <button
                id={`hero-tab-${tab.id}`}
                class="hero-tab"
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`hero-panel-${tab.id}`}
                tabindex={i === 0 ? undefined : -1}
              >
                {tab.label}
              </button>
            ))
          }
        </div>
        {
          heroTabs.map((tab, i) => (
            <div
              id={`hero-panel-${tab.id}`}
              class="hero-panel"
              role="tabpanel"
              aria-labelledby={`hero-tab-${tab.id}`}
              hidden={i !== 0}
            >
              <Picture
                src={tab.image}
                alt={tab.alt}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[640, 960, 1280, 1800, 2400]}
                sizes="(min-width: 1248px) 1200px, 100vw"
                fetchpriority={i === 0 ? 'high' : undefined}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
          ))
        }
      </div>
      <p class="hero-credit">
        The site in these screenshots is OpenTechCheck, also by us — see what any website is built
        with. <a href="https://opentechcheck.com" target="_blank" rel="noopener">Try it now</a>
      </p>
    </div>
  </section>

  <!-- Proof. site-worker.js rewrites the two data-stat elements at the edge,
       and the script below refreshes them from /api/stats.json in the
       browser; the numbers in the markup are the fallback when both miss. -->
  <section class="proof-strip" aria-label="In numbers">
    <ul class="container-wide proof">
      <li><b data-stat="users">1k</b> users on the Chrome Web Store</li>
      <li><b data-stat="stars">66</b> stars on GitHub</li>
      <li>MIT licensed</li>
      <li>Works offline</li>
    </ul>
  </section>

  <!-- Trio -->
  <section class="section trio-section">
    <div class="container-wide">
      <ul class="trio">
        {
          trio.map((t) => (
            <li>
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d={t.icon} />
              </svg>
              <h2>{t.title}</h2>
              <p class="trio-body">{t.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Alternating features -->
  {
    features.map((f, i) => (
      <section id={f.id} class="section feature">
        <div class:list={['container-wide', 'feature-grid', i % 2 === 1 && 'feature-flip']}>
          <div class="feature-copy">
            <p class="eyebrow">
              <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d={f.icon} />
              </svg>
              {f.kicker}
            </p>
            <h2>{f.title}</h2>
            <ul class="feature-list">
              {f.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <figure class="card feature-shot">
            <Picture
              src={f.image}
              alt={f.alt}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[480, 900, 1350, 1800]}
              sizes="(min-width: 900px) 580px, 100vw"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </section>
    ))
  }

  <!-- Privacy -->
  <section id="privacy" class="section slab">
    <div class="container-wide split">
      <div>
        <p class="eyebrow">Privacy</p>
        <h2>Nobody can see what you capture. Not even us.</h2>
        <p class="lede">
          Screenshots are often the most sensitive images on your machine. Capture, editing, export,
          PDF and recording all run in your browser. The extension makes no network request of its
          own, and it has no standing access to any site you visit.
        </p>
      </div>
      <dl class="card receipt">
        {
          receipt.map((row) => (
            <div>
              <dt>{row.k}</dt>
              <dd>{row.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="container-wide">
      <h3 class="sub-head">What it asks for at install</h3>
      <PermissionTable rows={installPermissions} />

      <h3 class="sub-head">What recording adds, only when you record</h3>
      <PermissionTable rows={recordingPermissions} />

      <p class="fine">
        The microphone and camera, when you enable them, are opened by your browser’s own permission
        prompt. The stream never leaves your device.
      </p>
    </div>
  </section>

  <!-- Agents & CLI -->
  <section id="cli" class="section">
    <div class="container-wide">
      <p class="eyebrow">
        <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d={icons.terminal} />
        </svg>
        Agents & CLI
      </p>
      <h2>Scriptable from your terminal. <span class="muted">Still local.</span></h2>
      <div class="card cli">
        <div class="cli-about">
          <p class="cli-name"><code>openscreenshot</code> on npm</p>
          <ul>
            <li>A separate, optional tool for scripts and AI agents</li>
            <li>Drives the Chrome already on your machine</li>
            <li>No browser download, no hosted service</li>
            <li>Also an MCP server, with a <code>capture_screenshot</code> tool</li>
          </ul>
        </div>
        <div class="cli-code">
          <p class="cli-label">One screenshot</p>
          <pre class="code"><code>npx openscreenshot shot https://example.com --out shot.png --full</code></pre>
          <p class="cli-label">MCP client config</p>
          <pre class="code"><code>{'{ "command": "npx", "args": ["openscreenshot", "serve"] }'}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section">
    <div class="container-wide">
      <p class="eyebrow">FAQ</p>
      <h2>Questions, answered.</h2>
      <FaqList items={homeFaq} />
      <p class="fine">
        Every question, plus the known limits, on the <a href="/support/">Support page</a>.
      </p>
    </div>
  </section>

  <!-- Final CTA -->
  <section id="download" class="section cta-final">
    <div class="container-wide">
      <h2>Ready in ten seconds.</h2>
      <ol class="steps">
        {
          steps.map((step, i) => (
            <li class="card step">
              <p class="step-n" aria-hidden="true">
                {i + 1}
              </p>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="cta-row">
        <a class="btn btn-ink btn-install" href={STORE_URL} target="_blank" rel="noopener">
          <ChromeIcon size={22} />
          Install in browser
        </a>
      </p>
      <p class="fine">Works on Chrome, Edge, Brave, Arc and other Chromium browsers.</p>
    </div>
  </section>

  <Fragment slot="body-end">
    <script is:inline src="/assets/webmcp.js" defer></script>
  </Fragment>
</Base>

<script>
  // The hero showcase: a sliding white thumb under the active tab, panels
  // toggled through [hidden]. Arrow keys move between tabs per the ARIA
  // tabs pattern.
  const tablist = document.querySelector<HTMLElement>('.hero-tabs');
  const thumb = tablist?.querySelector<HTMLElement>('.hero-tabs-thumb');
  const tabs = [...(tablist?.querySelectorAll<HTMLButtonElement>('.hero-tab') ?? [])];

  function placeThumb(tab: HTMLElement) {
    if (!thumb) return;
    thumb.style.width = `${tab.offsetWidth}px`;
    thumb.style.transform = `translateX(${tab.offsetLeft}px)`;
  }

  function select(tab: HTMLButtonElement, focus = false) {
    for (const t of tabs) {
      const active = t === tab;
      t.setAttribute('aria-selected', String(active));
      if (active) t.removeAttribute('tabindex');
      else t.setAttribute('tabindex', '-1');
      const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !active;
    }
    placeThumb(tab);
    if (focus) tab.focus();
  }

  if (tablist && thumb && tabs.length) {
    tablist.dataset.ready = 'false';
    placeThumb(tabs[0]);
    // Two frames so the initial placement lands before transitions turn on.
    requestAnimationFrame(() => requestAnimationFrame(() => (tablist.dataset.ready = 'true')));

    for (const tab of tabs) {
      tab.addEventListener('click', () => select(tab));
    }
    tablist.addEventListener('keydown', (e) => {
      const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!dir) return;
      e.preventDefault();
      const current = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
      select(tabs[(current + dir + tabs.length) % tabs.length], true);
    });
    window.addEventListener('resize', () => {
      const current = tabs.find((t) => t.getAttribute('aria-selected') === 'true');
      if (current) placeThumb(current);
    });
  }

  // Live counts for the proof strip. The edge already injects them
  // server-side; this refresh covers cached HTML and keeps the numbers
  // current. A miss (offline, localhost) leaves the fallback markup alone.
  fetch('/api/stats.json')
    .then((r) => (r.ok ? r.json() : null))
    .then((stats: Record<string, string | null> | null) => {
      if (!stats) return;
      for (const el of document.querySelectorAll<HTMLElement>('[data-stat]')) {
        const value = stats[el.dataset.stat ?? ''];
        if (value) el.textContent = value;
      }
    })
    .catch(() => {});
</script>

<style>
  /* ---- Rhythm ---- */

  .section {
    padding-block: clamp(56px, 8vw, 112px);
  }

  .section h2 {
    max-width: 26ch;
    margin-bottom: var(--s-6);
    font-size: var(--fs-title);
  }

  .fine {
    max-width: var(--max-w);
    color: var(--ink-3);
    font-size: var(--fs-sm);
  }

  .container-hero {
    max-width: var(--max-w-hero);
    margin-inline: auto;
    padding-inline: var(--s-5);
  }

  .icon {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon-sm {
    width: 16px;
    height: 16px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--s-3);
    margin: 0;
  }

  .gh-mark {
    width: 18px;
    height: 18px;
  }

  /* ---- Hero ---- */

  .hero {
    padding-top: clamp(48px, 8vw, 104px);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: clamp(40px, 6vw, 64px);
    text-align: center;
  }

  .hero-note {
    margin-bottom: var(--s-5);
    color: var(--ink-3);
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .hero h1 {
    margin-bottom: var(--s-5);
    font-size: var(--fs-hero);
  }

  .sub {
    max-width: 52ch;
    margin: 0 0 var(--s-6);
    color: var(--ink-2);
    font-size: var(--fs-lg);
  }

  .hero-frame {
    padding: 8px;
    border-radius: calc(var(--r-xl) + 8px);
    background: var(--grad-frame);
    box-shadow: var(--sh-card);
  }

  .hero-tabs {
    position: relative;
    display: flex;
    margin: 2px 2px 8px;
  }

  .hero-tab {
    position: relative;
    z-index: 1;
    flex: 1;
    min-width: 0;
    padding: 10px 12px;
    border: 0;
    border-radius: var(--r-full);
    background: none;
    color: rgba(255, 255, 255, 0.85);
    font: inherit;
    font-size: var(--fs-md);
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease);
  }

  .hero-tab:hover,
  .hero-tab[aria-selected='true'] {
    color: #fff;
  }

  .hero-tab[aria-selected='true'] {
    color: var(--ink);
  }

  .hero-tabs-thumb {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 0;
    border-radius: var(--r-full);
    background: #fff;
    box-shadow:
      0 1px 2px rgba(15, 10, 20, 0.1),
      0 6px 16px -8px rgba(15, 10, 20, 0.28);
    transition:
      transform var(--dur-mid) var(--ease),
      width var(--dur-mid) var(--ease);
  }

  /* Until the script measures the tabs (or without JS at all), the thumb
   * spans the first quarter, which is the first of the four equal tabs. */
  .hero-tabs:not([data-ready='true']) .hero-tabs-thumb {
    width: 25%;
    transition: none;
  }

  .hero-panel {
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--paper);
  }

  .hero-panel img {
    width: 100%;
  }

  .hero-credit {
    margin: var(--s-3) 0 0;
    color: var(--ink-3);
