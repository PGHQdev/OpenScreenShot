{
  "name": "openscreenshot",
  "version": "1.3.0",
  "description": "Open-source screenshot tool for Chrome — full-page, region, and visible-area capture with annotation and PDF export.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "author": "OpenScreenShot @PGHQdev",
  "repository": {
    "type": "git",
    "url": "https://github.com/pghqdev/OpenScreenShot"
  },
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "tokens": "node scripts/gen-design-tokens.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run tokens && tsc --noEmit && vite build",
    "package": "npm run build && rm -f openscreenshot-v$npm_package_version.zip && cd dist && zip -r -X ../openscreenshot-v$npm_package_version.zip .",
    "site:build": "astro build --root site",
    "site:dev": "astro dev --root site",
    "site:preview": "wrangler dev",
    "site:deploy": "npm run site:build && wrangler deploy",
    "shots": "node scripts/shots/render.mjs",
    "smoke:editor": "node tests/browser/editor-keyboard-smoke.mjs",
    "smoke:recorder": "node tests/browser/recorder-smoke.mjs",
    "smoke:setup": "node tests/browser/setup-smoke.mjs"
  },
  "dependencies": {
    "preact": "^10.29.4"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^9.39.4",
    "@preact/preset-vite": "^2.10.5",
    "@types/chrome": "^0.2.2",
    "astro": "^7.2.9",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.9",
    "wrangler": "^4.114.0"
  }
}
