{
  "name": "openscreenshot",
  "version": "2.1.0",
  "description": "Open-source screenshot tool for Chrome and Firefox \u2014 full-page, region, and visible-area capture with annotation and PDF export.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "author": "OpenScreenShot @PGHQdev",
  "repository": {
    "type": "git",
    "url": "https://github.com/pghqdev/OpenScreenShot"
  },
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "tokens": "node scripts/gen-design-tokens.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm run tokens && tsc --noEmit && vite build",
    "package": "pnpm run build && rm -f openscreenshot-v$npm_package_version.zip && cd dist && zip -r -X ../openscreenshot-v$npm_package_version.zip .",
    "site:build": "astro build --root site",
    "site:dev": "astro dev --root site",
    "site:preview": "wrangler dev",
    "site:deploy": "wrangler deploy",
    "shots": "node scripts/shots/render.mjs",
    "smoke:a11y": "node tests/browser/a11y-smoke.mjs",
    "smoke:editor": "node tests/browser/editor-keyboard-smoke.mjs",
    "smoke:media": "node tests/browser/media-a11y-smoke.mjs",
    "smoke:recorder": "node tests/browser/recorder-smoke.mjs",
    "smoke:region": "node tests/browser/region-select-smoke.mjs",
    "smoke:reflow": "node tests/browser/reflow-smoke.mjs",
    "smoke:setup": "node tests/browser/setup-smoke.mjs",
    "smoke:worker": "node tests/browser/worker-thumbnail-smoke.mjs",
    "smoke:capture": "node tests/browser/capture-overlay-smoke.mjs",
    "build:firefox": "pnpm run tokens && tsc --noEmit && vite build --mode firefox",
    "dev:firefox": "vite --mode firefox",
    "package:firefox": "pnpm run build:firefox && web-ext build --source-dir dist-firefox --artifacts-dir . --filename openscreenshot-firefox-v{version}.zip --overwrite-dest",
    "lint:firefox": "web-ext lint --source-dir dist-firefox",
    "source:firefox": "node scripts/package-firefox-source.mjs"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.2.9",
    "astro": "^7.3.2",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "web-ext": "^10.6.0",
    "wrangler": "^4.131.0"
  },
  "packageManager": "pnpm@10.33.0"
}
