{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.0.0",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "OpenScreenShot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "downloads",
    "contextMenus",
    "clipboardWrite",
    "offscreen"
  ],
  "host_permissions": [],
  "optional_permissions": ["tabCapture"],
  "optional_host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["src/recorder/webcam-frame.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_ui": {
    "page": "src/editor/index.html",
    "open_in_tab": true
  },
  "commands": {
    "capture-full-page": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Capture the full scrolling page"
    },
    "capture-visible": {
      "suggested_key": { "default": "Alt+Shift+V", "mac": "Command+Shift+V" },
      "description": "Capture the visible area"
    },
    "capture-region": {
      "suggested_key": { "default": "Ctrl+Shift+E", "mac": "Command+Shift+E" },
      "description": "Capture a selected region"
    },
    "stop-recording": {
      "suggested_key": { "default": "Alt+Shift+X", "mac": "Alt+Shift+X" },
      "description": "Stop the current recording"
    },
    "reveal-recording-bar": {
      "description": "Show the recording control bar"
    }
  }
}
